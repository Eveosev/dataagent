    "ExecRequest",
    "ExecOutput",
    "ExecutionHandle",
    "Signal"
  ],
  "traits": {
    "FsBackend": "read_file/write_file/list_dir/stat",
    "ExecBackend": "exec/signal/terminate"
  },
  "consumers": [
    "kernel/runtime/src/environment_registry.rs",
    "kernel/runtime/src/env_codex.rs",
    "kernel/host/src/transport/env*"
