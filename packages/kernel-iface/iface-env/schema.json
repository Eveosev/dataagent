{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agentcpm/iface-env",
  "version": "0.1.0",
  "description": "AgentCPM §4.2 iface-env / §6.7 跨设备缺口 的机器可读形状：类型、trait 方法、错误码、消费方。只定义形状，不含实现。",
  "lineage": "kernel/iface/src/env（verbatim 复制到本包 src/）",
  "spec": {
    "KERNEL-MECHANISMS-AND-ABI": "§4.2 iface-env / §6.7 跨设备缺口",
    "decision": [
      "D55"
    ]
  },
  "iface": {
    "name": "env",
    "layer": "L-A",
    "shared_types_dep": "agentcpm/iface-types",
    "errors": {
