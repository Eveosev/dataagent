#!/bin/sh
# dataagent unified CLI dispatcher (12-unified-cli-research §5.1/§5.3).
#
# Dispatches `dataagent <layer> ...` to the sibling layer package's in-package
# .venv interpreter — the three layers are never loaded in one process
# (governance pins duckdb<2 / sqlglot<27, application pins duckdb 2.0.0 /
# sqlglot 30.29). Before exec the ambient environment is scrubbed down to a
# whitelist (§5.4): credentials that happen to live in the host environment
# never reach the layer process.
#
# Commands:
#   dataagent <data|app|gov> ...    layer dispatch (list / run / --help / ...)
#   dataagent link                 generate ./dataagent in the project root
#   dataagent setup                uv sync --frozen for all three layers
#   dataagent doctor               check packages, .venv, policy, data_root, mode
#
# POSIX sh only, no Python dependency.

set -eu

MARKER='# dataagent unified CLI dispatcher'
LAYERS="data app gov"
MODULE_data=dataagent_data
MODULE_application=dataagent_application
MODULE_governance=dataagent_governance

die() { echo "dataagent: $*" >&2; exit 3; }

layer_pkg() {
    case $1 in
        data) echo "data-layer" ;;
        app) echo "application-layer" ;;
        gov) echo "governance-layer" ;;
        *) return 1 ;;
    esac
}

module_of() {
    case $1 in
        data) echo "$MODULE_data" ;;
        app) echo "$MODULE_application" ;;
        gov) echo "$MODULE_governance" ;;
        *) return 1 ;;
    esac
}

# Version pinned in mint.lock wins; without a pin the highest installed
# version is used (12 §5.1: 按 mint.lock 取版本). A pin that is not
# installed is an environment error (exit 3) — never silently fall back
# to another version (r5-review D13). A lock that has no entry for this
# layer is simply "no pin" for this layer (r6-review D16): an installed
# layer must resolve exactly like the no-lock case.
#
# pinned_version never dies and never prints on its "no pin" paths; its
# exit status is consumed with `||` (NOT inside `if` — a die in an if
# condition is swallowed by the subshell and would fail open, which is
# exactly the r7-review D16 regression):
#   0  this layer is pinned (version on stdout)
#   1  no mint.lock, or no entry for this package — callers fall back
#      to the highest installed version
#   2  mint.lock has an entry for this package whose version cannot be
#      read, or the lock cannot be parsed — a corrupt lock; callers
#      must fail closed (exit 3)
#
# The lock is parsed with a single-pass character-level TOML scanner
# (POSIX awk, no Python; LC_ALL=C keeps sprintf("%c") byte-exact on both
# BSD awk and gawk). r9-review D16 rejected the previous line-based
# parser: it silently reclassified legal, Mint-accepted TOML as "no
# pin" and bypassed the lock. The scanner mirrors the stdlib tomllib
# grammar for the one question that matters here — the top-level
# `package` entries and their name/version keys — and answers the TOML
# equivalence classes wholesale instead of one formatting variant at a
# time:
#   - table headers are key paths: `[ "package" ]`, `[["package"]]`,
#     `[[ 'package' ]]`, `[["pack\u0061ge"]]` and `[ package ]` all
#     address the same top-level `package` entry as `[[package]]`;
#     dotted paths (`[[package.requires]]`, `[core]`,
#     `[package.artifacts.any]`) are different tables and their
#     name/version keys are never pins;
#   - keys are dotted paths of bare/quoted segments with full basic-
#     string unescaping, so `"\u006eame" = …` is `name = …`;
#   - values are complete TOML values: basic/literal strings, single-
#     line and multi-line (`"""…"""` / `'''…'''`, leading-newline trim
#     and `\`-continuation included), inline tables and (multi-line)
#     arrays, numbers/bools/datetimes as opaque tokens;
#   - the top-level `package` key can also be defined inline
#     (`package = [{name = …, version = …}]`), which is the same array
#     of entries as `[[package]]` — the pin is read from either;
#   - anything that cannot be resolved — an unparseable file, an entry
#     whose name is not a string (it might be this package), a matching
#     entry without a readable version, a non-container `package` value,
#     or a second definition of `package` — exits 2 (fail closed), so
#     no legal representation can silently downgrade to "no pin".
pinned_version() {
    pkg=$1
    [ -f ./mint.lock ] || return 1
    ver=""
    rc=0
    # sq is a single quote, passed via -v so the program body carries no
    # quote that would end the shell's single-quoted awk argument.
    ver=$(LC_ALL=C awk -v want="dataagent/$pkg" -v sq="'" '
        # ---- byte helpers -------------------------------------------------
        function hexval(h,  i, c, d, v) {
            v = 0
            for (i = 1; i <= length(h); i++) {
                c = tolower(substr(h, i, 1))
                d = index("0123456789abcdef", c) - 1
                if (d < 0) return -1
                v = v * 16 + d
            }
            return v
        }
        # code point -> UTF-8 bytes (ASCII fast path covers real locks)
        function utf8(cp) {
            if (cp < 128) return sprintf("%c", cp)
            if (cp < 2048) return sprintf("%c%c", 192 + int(cp / 64), 128 + cp % 64)
            if (cp < 65536) return sprintf("%c%c%c", 224 + int(cp / 4096), 128 + int(cp / 64) % 64, 128 + cp % 64)
            return sprintf("%c%c%c%c", 240 + int(cp / 262144), 128 + int(cp / 4096) % 64, 128 + int(cp / 64) % 64, 128 + cp % 64)
        }
        function isbare(c) {
            return index("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-", c) > 0
        }
        # skip blanks; with nl also newlines and whole-line comments
        # (array/inline-table/statement separators, tomllib-style)
        function skipblank(nl,  c) {
            while (p <= n) {
                c = substr(buf, p, 1)
                if (c == " " || c == "\t" || c == "\r") { p++; continue }
                if (nl && c == "\n") { p++; continue }
                if (nl && c == "#") { while (p <= n && substr(buf, p, 1) != "\n") p++; continue }
                break
            }
        }
        # blanks and newlines only (no comments) — used after a
        # `\`-continuation inside a multi-line basic string
        function skipwsnl(  c) {
            while (p <= n) {
                c = substr(buf, p, 1)
                if (c == " " || c == "\t" || c == "\r" || c == "\n") p++
                else break
            }
        }
        # decode the escape sequence at buf[p] == "\\" (p advanced past
        # it); sets badx on any illegal escape or non-scalar \u value
        function esc(ml,  c, h, ln, j, cp) {
            c = substr(buf, p + 1, 1)
            # multi-line only: `\`-continuation trims trailing blanks,
            # the newline and the next line leading blanks
            if (ml && (c == " " || c == "\t")) {
                j = p + 1
                while (j <= n && (substr(buf, j, 1) == " " || substr(buf, j, 1) == "\t")) j++
                if (j > n) { p = j; return "" }
                if (substr(buf, j, 1) != "\n") { badx = 1; return "" }
                p = j + 1
                skipwsnl()
                return ""
            }
            if (ml && c == "\n") { p += 2; skipwsnl(); return "" }
            if (c == "b") { p += 2; return "\b" }
            if (c == "t") { p += 2; return "\t" }
            if (c == "n") { p += 2; return "\n" }
            if (c == "f") { p += 2; return "\f" }
            if (c == "r") { p += 2; return "\r" }
            if (c == "e") { p += 2; return sprintf("%c", 27) }
            if (c == "\"") { p += 2; return "\"" }
            if (c == "\\") { p += 2; return "\\" }
            if (c == "x" || c == "u" || c == "U") {
                ln = (c == "x") ? 2 : ((c == "u") ? 4 : 8)
                h = substr(buf, p + 2, ln)
                if (length(h) != ln) { badx = 1; return "" }
                cp = hexval(h)
                if (cp < 0 || (cp >= 55296 && cp <= 57343) || cp > 1114111) { badx = 1; return "" }
                p += 2 + ln
                return utf8(cp)
            }
            badx = 1
            return ""
        }
        # scan the basic string starting at buf[p] == `"`; allow_ml
        # permits """multi-line""" forms (keys use one-line strings
        # only, like tomllib). Decoded text in strv; 1 ok, 0 bad.
        function basic_string(allow_ml,  q3, ml, val, closed, c) {
            q3 = "\"\"\""
            ml = (allow_ml && substr(buf, p, 3) == q3) ? 1 : 0
            p += ml ? 3 : 1
            if (ml && substr(buf, p, 1) == "\n") p++
            val = ""
            closed = 0
            while (p <= n) {
                c = substr(buf, p, 1)
                if (c == "\"") {
                    if (! ml) { p++; closed = 1; break }
                    if (substr(buf, p, 3) == q3) {
                        p += 3
                        # up to two extra quotes belong to the content
                        if (substr(buf, p, 1) == "\"") { val = val "\""; p++ }
                        if (substr(buf, p, 1) == "\"") { val = val "\"\""; p++ }
                        closed = 1
                        break
                    }
                    val = val c
                    p++
                    continue
                }
                if (c == "\\") {
                    val = val esc(ml)
                    if (badx) return 0
                    continue
                }
                if (! ml && c == "\n") return 0
                val = val c
                p++
            }
            if (! closed) return 0
            strv = val
            return 1
        }
        # scan the literal string starting at buf[p] == sq; same shape
        # as basic_string but without escapes
        function literal_string(allow_ml,  t3, ml, val, closed, c) {
            t3 = sprintf("%s%s%s", sq, sq, sq)
            ml = (allow_ml && substr(buf, p, 3) == t3) ? 1 : 0
            p += ml ? 3 : 1
            if (ml && substr(buf, p, 1) == "\n") p++
            val = ""
            closed = 0
            while (p <= n) {
                c = substr(buf, p, 1)
                if (c == sq) {
                    if (! ml) { p++; closed = 1; break }
                    if (substr(buf, p, 3) == t3) {
                        p += 3
                        if (substr(buf, p, 1) == sq) { val = val sq; p++ }
                        if (substr(buf, p, 1) == sq) { val = val sq sq; p++ }
                        closed = 1
                        break
                    }
                    val = val c
                    p++
                    continue
                }
                if (! ml && c == "\n") return 0
                val = val c
                p++
            }
            if (! closed) return 0
            strv = val
            return 1
        }
        # parse a dotted key path of bare/quoted segments into kp[1..kpn]
        # (segment text fully decoded); 1 ok, 0 bad
        function parse_key_path(  c, j, seg) {
            kpn = 0
            while (1) {
                c = substr(buf, p, 1)
                if (c == "\"") { if (! basic_string(0)) return 0; seg = strv }
                else if (c == sq) { if (! literal_string(0)) return 0; seg = strv }
                else {
                    j = p
                    while (j <= n && isbare(substr(buf, j, 1))) j++
                    if (j == p) return 0
                    seg = substr(buf, p, j - p)
                    p = j
                }
                kpn++
                kp[kpn] = seg
                skipblank(0)
                if (substr(buf, p, 1) != ".") return 1
                p++
                skipblank(0)
            }
        }
        function entry_reset() {
            e_name = ""; e_ver = ""; nameok = 1; verok = 0; nhad = 0; vhad = 0
        }
        # ---- key-path registry (tomllib duplicate/overwrite rules) ------
        # reg[joined path]: "val" (key = value), "hdr_t" ([t] declared),
        # "hdr_a" ([[t]] element), "imp" (implicit parent of a header),
        # "dot" (table created by a dotted-key prefix). A second value
        # at the same path, a value under a scalar, or a header on an
        # already-defined key is a corrupt lock -> fail closed.
        function seg_at(i) { return (i <= ctxn) ? ctx[i] : kp[i - ctxn] }
        function reg_keyval(  m, full, i, pref, ty) {
            m = ctxn + kpn
            full = ""
            for (i = 1; i <= m; i++) full = (i == 1) ? seg_at(i) : full SUBSEP seg_at(i)
            pref = ""
            for (i = 1; i < m; i++) {
                pref = (i == 1) ? seg_at(i) : pref SUBSEP seg_at(i)
                if (reg[pref] == "val") { bad = 1; return }
            }
            if (reg[full] != "") { bad = 1; return }
            reg[full] = "val"
            pref = ""
            for (i = 1; i < m; i++) {
                pref = (i == 1) ? seg_at(i) : pref SUBSEP seg_at(i)
                if (reg[pref] == "") reg[pref] = "dot"
            }
        }
        function clear_sub(h,  k, pre, lst, cnt, i) {
            pre = h SUBSEP
            cnt = 0
            for (k in reg) if (index(k, pre) == 1) lst[++cnt] = k
            for (i = 1; i <= cnt; i++) delete reg[lst[i]]
        }
        function reg_header(arrflag,  h, i, pref, ty) {
            h = ""
            for (i = 1; i <= kpn; i++) h = (i == 1) ? kp[i] : h SUBSEP kp[i]
            pref = ""
            for (i = 1; i < kpn; i++) {
                pref = (i == 1) ? kp[i] : pref SUBSEP kp[i]
                if (reg[pref] == "val") { bad = 1; return }
            }
            ty = reg[h]
            if (arrflag) {
                if (ty != "" && ty != "hdr_a") { bad = 1; return }
                reg[h] = "hdr_a"
                clear_sub(h)
            } else {
                if (ty != "" && ty != "imp") { bad = 1; return }
                reg[h] = "hdr_t"
            }
            pref = ""
            for (i = 1; i < kpn; i++) {
                pref = (i == 1) ? kp[i] : pref SUBSEP kp[i]
                if (reg[pref] == "" || reg[pref] == "imp") reg[pref] = "imp"
            }
        }
        # finish the current package entry: an unreadable name might be
        # this package, and a matching entry needs a readable version —
        # both fail closed; first matching entry wins
        function flush_entry(force) {
            if ((force || pkgmode) && ! seen) {
                if (! nameok) bad = 1
                else if (e_name == want) {
                    seen = 1
                    if (! verok || e_ver == "") bad = 1
                    else { print e_ver; got = 1 }
                }
            }
            entry_reset()
        }
        # parse one value starting at p. mode: 0 skip, 1 expect a
        # string (name/version), 2 the top-level `package` container.
        # Sets valtype ("str"/"arr"/"tbl"/"other") and, for strings,
        # strv. 0 return is signalled via bad.
        function parse_value(mode,  c, j, k, j2, tok, c2) {
            valtype = ""
            if (p > n) { bad = 1; return }
            c = substr(buf, p, 1)
            if (c == "\"") { if (! basic_string(1)) { bad = 1; return }; valtype = "str"; return }
            if (c == sq) { if (! literal_string(1)) { bad = 1; return }; valtype = "str"; return }
            if (c == "[") { parse_array(mode); valtype = "arr"; return }
            if (c == "{") { parse_inline_table(mode == 2 ? 3 : 0); valtype = "tbl"; return }
            if (c == "\n" || c == "," || c == "]" || c == "}" || c == "#") { bad = 1; return }
            j = p
            while (j <= n) {
                c2 = substr(buf, j, 1)
                if (c2 == " " || c2 == "\t" || c2 == "\r" || c2 == "\n" || c2 == "," || c2 == "]" || c2 == "}" || c2 == "#") break
                j++
            }
            # the one TOML value with an inner space: `1979-05-27 07:32:00`
            if (substr(buf, j, 1) == " ") {
                k = j + 1
                while (k <= n && substr(buf, k, 1) == " ") k++
                j2 = k
                while (j2 <= n) {
                    c2 = substr(buf, j2, 1)
                    if (c2 == " " || c2 == "\t" || c2 == "\r" || c2 == "\n" || c2 == "," || c2 == "]" || c2 == "}" || c2 == "#") break
                    j2++
                }
                tok = substr(buf, k, j2 - k)
                if (tok ~ /^[0-9][0-9]:/) j = j2
            }
            if (j == p) { bad = 1; return }
            p = j
            valtype = "other"
        }
        # array; elements separated by `,` with blanks/newlines/comments
        # allowed and a trailing comma. mode 2 = the package array:
        # each element must be an inline table entry (captured)
        function parse_array(mode,  c) {
            p++
            while (1) {
                skipblank(1)
                if (p > n) { bad = 1; return }
                c = substr(buf, p, 1)
                if (c == "]") { p++; return }
                if (mode == 2) {
                    if (c != "{") { bad = 1; return }
                    entry_reset()
                    parse_inline_table(3)
                    if (bad) return
                    flush_entry(1)
                } else {
                    parse_value(0)
                    if (bad) return
                }
                skipblank(1)
                if (p > n) { bad = 1; return }
                c = substr(buf, p, 1)
                if (c == ",") { p++; continue }
                if (c == "]") { p++; return }
                bad = 1
                return
            }
        }
        # inline table `{ k = v, … }` (newlines tolerated, tomllib-style);
        # cap 3 = a package entry — its top-level name/version captured,
        # nested tables/arrays never contribute. Each instance gets its
        # own key-path scope (duplicate keys within one instance only)
        function parse_inline_table(cap,  c, first) {
            p++
            inl_cnt++
            ctxn++
            ctx[ctxn] = sprintf("%c%d", 30, inl_cnt)
            if (cap == 3) entry_reset()
            first = 1
            while (1) {
                skipblank(1)
                if (p > n) { bad = 1; return }
                c = substr(buf, p, 1)
                if (c == "}") { p++; ctxn--; if (cap == 3) flush_entry(1); return }
                if (! first) {
                    if (c != ",") { bad = 1; return }
                    p++
                    skipblank(1)
                    if (p > n) { bad = 1; return }
                    c = substr(buf, p, 1)
                    if (c == "}") { p++; ctxn--; if (cap == 3) flush_entry(1); return }
                }
                first = 0
                if (! parse_key_path()) { bad = 1; return }
                skipblank(0)
                if (substr(buf, p, 1) != "=") { bad = 1; return }
                p++
                skipblank(0)
                reg_keyval()
                if (bad) return
                if (cap == 3 && kpn == 1 && (kp[1] == "name" || kp[1] == "version")) {
                    parse_value(1)
                    if (bad) return
                    if (kp[1] == "name") {
                        if (nhad) { bad = 1; return }
                        nhad = 1
                        if (valtype != "str") { e_name = ""; nameok = 0 }
                        else e_name = strv
                    } else {
                        if (vhad) { bad = 1; return }
                        vhad = 1
                        if (valtype != "str") { e_ver = ""; verok = 0 }
                        else { e_ver = strv; verok = 1 }
                    }
                } else {
                    parse_value(0)
                    if (bad) return
                }
            }
        }
        # `[table]` / `[[array]]` header: a key path, so quoted/escaped
        # segments address the same table. Only a single top-level
        # `package` segment is a package entry; conflicts between the
        # array, table and inline definitions fail closed (tomllib
        # rejects a doubly-declared key)
        function parse_header(  arr, i) {
            flush_entry(0)
            p++
            if (substr(buf, p, 1) == "[") { arr = 1; p++ } else arr = 0
            skipblank(0)
            if (! parse_key_path()) { bad = 1; return }
            if (substr(buf, p, 1) != "]") { bad = 1; return }
            p++
            if (arr) {
                if (substr(buf, p, 1) != "]") { bad = 1; return }
                p++
            }
            for (i = 1; i <= kpn; i++) ctx[i] = kp[i]
            reg_header(arr)
            if (bad) return
            if (kpn == 1 && kp[1] == "package") {
                if (arr) {
                    if (pkg_tbl || pkg_inline) { bad = 1; return }
                    pkg_arr = 1
                } else {
                    if (pkg_arr || pkg_tbl || pkg_inline) { bad = 1; return }
                    pkg_tbl = 1
                }
                pkgmode = 1
                entry_reset()
            } else {
                # a sub-table of an inline-defined `package` would
                # mutate a frozen namespace
                if (kpn >= 2 && kp[1] == "package" && pkg_inline) { bad = 1; return }
                pkgmode = 0
            }
            ctxn = kpn
        }
        # key = value inside the current table; the root `package` key
        # is the inline container, name/version inside a package entry
        # are the pin fields, everything else is skipped
        function parse_keyval(  c) {
            if (! parse_key_path()) { bad = 1; return }
            skipblank(0)
            if (substr(buf, p, 1) != "=") { bad = 1; return }
            p++
            skipblank(0)
            reg_keyval()
            if (bad) return
            if (ctxn == 0 && kp[1] == "package") {
                if (kpn != 1 || pkg_arr || pkg_tbl || pkg_inline) { bad = 1; return }
                pkg_inline = 1
                parse_value(2)
                if (bad) return
                if (valtype != "arr" && valtype != "tbl") { bad = 1; return }
            } else if (pkgmode && kpn == 1 && (kp[1] == "name" || kp[1] == "version")) {
                parse_value(1)
                if (bad) return
                if (kp[1] == "name") {
                    if (nhad) { bad = 1; return }
                    nhad = 1
                    if (valtype != "str") { e_name = ""; nameok = 0 }
                    else e_name = strv
                } else {
                    if (vhad) { bad = 1; return }
                    vhad = 1
                    if (valtype != "str") { e_ver = ""; verok = 0 }
                    else { e_ver = strv; verok = 1 }
                }
            } else {
                parse_value(0)
                if (bad) return
            }
            if (bad) return
            # statement tail: blanks, one optional comment, newline/EOF
            skipblank(0)
            c = substr(buf, p, 1)
            if (c == "#") {
                while (p <= n && substr(buf, p, 1) != "\n") p++
                c = (p <= n) ? "\n" : ""
            }
            if (c != "" && c != "\n") { bad = 1; return }
        }
        # ---- driver -------------------------------------------------------
        { buf = buf $0 "\n" }
        END {
            n = length(buf)
            p = 1
            bad = 0; badx = 0; got = 0; seen = 0
            pkgmode = 0; pkg_arr = 0; pkg_tbl = 0; pkg_inline = 0; ctxn = 0
            entry_reset()
            while (p <= n && ! bad) {
                skipblank(1)
                if (p > n) break
                c = substr(buf, p, 1)
                if (c == "[") parse_header()
                else if (c == "\"" || c == sq || isbare(c)) parse_keyval()
                else bad = 1
            }
            if (! bad) flush_entry(0)
            exit (bad || badx) ? 2 : (got ? 0 : 1)
        }
    ' ./mint.lock) || rc=$?
    case $rc in
        0) printf '%s\n' "$ver"; return 0 ;;
        1) return 1 ;;
        *) return 2 ;;
    esac
}

# Shared capture of pinned_version's three-way outcome (r7-review D16):
# sets pin_ver / pin_rc. Callers MUST consume pin_rc — 2 (unreadable
# lock entry) has to fail closed (die in dispatch paths, a failing
# doctor check) and must never fall through to highest-installed.
pin_status() {
    pkg=$1
    pin_rc=0
    pin_ver=$(pinned_version "$pkg") || pin_rc=$?
}

resolve_dir() {
    pkg=$1
    root=./.mint/packages/dataagent
    [ -d "$root" ] || die "no installed dataagent packages under $root (mint add dataagent/preset-s0)"
    dir=""
    pin_status "$pkg"
    [ "$pin_rc" -ne 2 ] || die "mint.lock has an entry for dataagent/$pkg without a readable version (regenerate mint.lock)"
    if [ "$pin_rc" -eq 0 ]; then
        [ -d "$root/$pkg@$pin_ver" ] || die "mint.lock pins dataagent/$pkg@$pin_ver but that version is not installed (mint add dataagent/preset-s0)"
        dir="$root/$pkg@$pin_ver"
    fi
    if [ -z "$dir" ]; then
        dir=$(ls -d "$root/$pkg@"* 2>/dev/null | sort -V | tail -1) || dir=""
    fi
    [ -n "$dir" ] || die "package dataagent/$pkg is not installed"
    printf '%s\n' "$dir"
}

python_of() {
    dir=$1
    py="$dir/.venv/bin/python"
    [ -x "$py" ] || die "no .venv in $dir (run: dataagent setup)"
    printf '%s\n' "$py"
}

# §5.4: clear every variable unrelated to DataAgent before exec'ing the
# layer process; keep only the whitelist + DATAAGENT_*.
scrub_env() {
    for name in $(env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p'); do
        case $name in
            DATAAGENT_*|PATH|HOME|LANG|LC_*|TZ|TMPDIR|TERM) ;;
            *) unset "$name" 2>/dev/null || true ;;
        esac
    done
}

dispatch() {
    layer=$1
    shift
    pkg=$(layer_pkg "$layer") || die "unknown layer: $layer (data | app | gov)"
    module=$(module_of "$layer")
    dir=$(resolve_dir "$pkg")
    py=$(python_of "$dir")
    scrub_env
    exec "$py" -m "$module.interfaces.cli" "$@"
}

link_cmd() {
    target=./dataagent
    if [ -e "$target" ] && ! head -n 2 "$target" 2>/dev/null | grep -qF "$MARKER" 2>/dev/null; then
        echo "dataagent: refusing to overwrite $PWD/dataagent (not a dataagent launcher)" >&2
        exit 2
    fi
    cat "$0" > "$target"
    chmod +x "$target"
    echo "$PWD/dataagent"
}

setup_cmd() {
    command -v uv >/dev/null 2>&1 || die "uv not found on PATH; install it or run uv sync inside each layer package"
    for layer in $LAYERS; do
        pkg=$(layer_pkg "$layer")
        dir=$(resolve_dir "$pkg") || exit 3
        echo "setup: $dir"
        (cd "$dir" && uv sync --frozen) || die "uv sync --frozen failed in $dir"
    done
    echo "setup: ok"
}

# doctor: report, don't die — collect every failing check into one exit
# status (3). A missing policy is a failing check, not a success with a
# note (r5-review D14): enforce-mode runs would exit 3 on the next
# --authorize anyway.
doctor_cmd() {
    status=0
    for layer in $LAYERS; do
        pkg=$(layer_pkg "$layer")
        dir=""
        # Same resolution order as resolve_dir (r6-review D16): pin when
        # mint.lock pins this layer (and it is installed), otherwise the
        # highest installed version — never a missing-pin rejection. An
        # unreadable pin is a failing check, not a fallback (r7-review
        # D16): dispatch would exit 3 on the same lock.
        pin_status "$pkg"
        case $pin_rc in
            0)
                if [ ! -d "./.mint/packages/dataagent/$pkg@$pin_ver" ]; then
                    echo "package  dataagent/$pkg: MISSING pinned $pin_ver (mint add dataagent/preset-s0)" >&2
                    status=3
                    continue
                fi
                dir="./.mint/packages/dataagent/$pkg@$pin_ver"
                ;;
            1) ;;
            *)
                echo "package  dataagent/$pkg: LOCK unreadable (regenerate mint.lock)" >&2
                status=3
                continue
                ;;
        esac
        if [ -z "$dir" ]; then
            dir=$(ls -d "./.mint/packages/dataagent/$pkg@"* 2>/dev/null | sort -V | tail -1) || dir=""
        fi
        if [ -z "$dir" ]; then
            echo "package  dataagent/$pkg: MISSING (mint add dataagent/preset-s0)" >&2
            status=3
            continue
        fi
        echo "package  dataagent/$pkg: $dir"
        if [ -x "$dir/.venv/bin/python" ]; then
            if "$dir/.venv/bin/python" -c "import $(module_of "$layer")" >/dev/null 2>&1; then
                echo "venv     $pkg: ok"
            else
                echo "venv     $pkg: BROKEN import (run: dataagent setup)" >&2
                status=3
            fi
        else
            echo "venv     $pkg: MISSING (run: dataagent setup)" >&2
            status=3
        fi
    done
    root=${DATAAGENT_DATA_ROOT:-$PWD/.dataagent}
    if [ -d "$root" ]; then
        echo "data_root: $root"
    else
        echo "data_root: $root (will be created on first run)"
    fi
    gov_dir=""
    # Same three-way pin outcome for the policy probe (r7-review D16):
    # unreadable pin → no dir → "governance layer unavailable" instead
    # of probing a bypassed version.
    pin_status "governance-layer"
    case $pin_rc in
        0) gov_dir="./.mint/packages/dataagent/governance-layer@$pin_ver" ;;
        1) gov_dir=$(ls -d ./.mint/packages/dataagent/governance-layer@* 2>/dev/null | sort -V | tail -1) || gov_dir="" ;;
    esac
    if [ -n "$gov_dir" ] && [ -x "$gov_dir/.venv/bin/python" ]; then
        # exit 0 = policy configured, 1 = none, anything else = probe broken
        probe='
try:
    from dataagent_governance.runtime import default_runtime as d
except Exception:
    raise SystemExit(2)
try:
    d().policy.load(None)
except Exception:
    raise SystemExit(1)
'
        rc=0
        "$gov_dir/.venv/bin/python" -c "$probe" >/dev/null 2>&1 || rc=$?
        case $rc in
            0) echo "policy:   configured" ;;
            1) echo "policy:   none (run: dataagent gov policy apply <policy.json>)" >&2
               status=3 ;;
            *) echo "policy:   check failed" >&2
               status=3 ;;
        esac
    else
        echo "policy:   governance layer unavailable" >&2
        status=3
    fi
    echo "mode:     DATAAGENT_ENFORCEMENT_MODE=${DATAAGENT_ENFORCEMENT_MODE:-warn (default)}"
    if [ "$status" -ne 0 ]; then
        echo "doctor: failing checks above (exit 3)" >&2
    fi
    exit "$status"
}

usage() {
    cat >&2 <<'EOF'
usage: dataagent <layer> <command> [flags]
       dataagent link
       dataagent setup
       dataagent doctor

layers: data | app | gov

layer commands (see `dataagent <layer> <op> --help` for the parameter table):
  dataagent <layer> list                          one line per operation
  dataagent <layer> run <op> --set k=v ...        call an atom
  dataagent <layer> run <op> --file <path>         build a FileRef from bytes
  dataagent <layer> run <op> --ref f=<id@rev>      reuse an earlier result
  dataagent <layer> run <op> --authorize           fill authorization_ref
  dataagent gov policy apply <file>                write an access policy
  dataagent gov confirm <file>                     confirm acceptance criteria

stdout is a summary JSON (status, issues, handles, result_path); the full
result lands in .dataagent/results/<invocation_id>.json. exit: 0 ok/partial/
needs_input, 1 failed, 2 usage, 3 environment missing.
EOF
    exit 2
}

[ $# -ge 1 ] || usage
case $1 in
    data|app|gov) dispatch "$@" ;;
    link) [ $# -eq 1 ] && link_cmd || usage ;;
    setup) [ $# -eq 1 ] && setup_cmd || usage ;;
    doctor) [ $# -eq 1 ] && doctor_cmd || usage ;;
    -h|--help|help) usage ;;
    *) usage ;;
esac
