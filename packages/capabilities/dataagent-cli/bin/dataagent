#!/bin/sh
# dataagent unified CLI dispatcher (12-unified-cli-research §5.1/§5.3).
#
# Dispatches `dataagent <layer> ...` to the sibling layer package's in-package
# .venv interpreter — the three layers are never loaded in one process
# (governance pins duckdb<2 / sqlglot<27, application pins duckdb 2.0.0 /
# sqlglot 30.29). Before exec the ambient environment is scrubbed down to a
# whitelist (§5.4): credentials that happen to live in the host environment
# never reach the layer process.
#
# Commands:
#   dataagent <data|app|gov> ...    layer dispatch (list / run / --help / ...)
#   dataagent run --case <case.json> --out <dir> --config <cfg.json>
#                                  run one 09-benchmark case (07 T30) through
#                                  dataagent_runtime.interfaces.bench in the
#                                  data layer's installed interpreter
#   dataagent link                 generate ./dataagent in the project root
#   dataagent setup [--ocr-root <dir>]
#                                  uv sync --frozen for all layers; with
#                                  --ocr-root, install a verified OCR
#                                  directory into <data_root>/ocr
#   dataagent doctor               check packages, .venv, data_root,
#                                  connections + credential references,
#                                  running workbench service, policy, OCR, mode
#   dataagent workbench list|stop  list tasks; stop this workspace's service
#
# POSIX sh only, no Python dependency.

set -eu

MARKER='# dataagent unified CLI dispatcher'
LAYERS="data app gov"
MODULE_data=dataagent_data
MODULE_application=dataagent_application
MODULE_governance=dataagent_governance

die() { echo "dataagent: $*" >&2; exit 3; }

layer_pkg() {
    case $1 in
        data) echo "data-layer" ;;
        app) echo "application-layer" ;;
        gov) echo "governance-layer" ;;
        workbench) echo "workbench" ;;
        ops) echo "operations" ;;
        *) return 1 ;;
    esac
}

module_of() {
    case $1 in
        data) echo "$MODULE_data" ;;
        app) echo "$MODULE_application" ;;
        gov) echo "$MODULE_governance" ;;
        workbench) echo "dataagent_workbench" ;;
        ops) echo "dataagent_operations" ;;
        *) return 1 ;;
    esac
}

# Version resolution (12 §5.1). Mint keeps exactly one installed version of
# each package: every command that rewrites mint.lock (add / remove / sync)
# deletes installed versions that differ from the lock
# (agent-kernel mint/bins/mint/src/install.rs prune_orphans). The single
# installed directory is therefore the locked one, and mint.lock is not
# parsed here. More than one installed version means the project is out of
# sync with its lock (an interrupted prune or a hand-placed directory):
# fail closed with exit 3 and point at `mint sync`.

# installed_dirs <pkg>: the installed version directories, one per line.
installed_dirs() {
    for d in ./.mint/packages/dataagent/"$1"@*; do
        [ -d "$d" ] && printf '%s\n' "$d"
    done
    return 0
}

count_lines() {
    if [ -z "$1" ]; then echo 0; else printf '%s\n' "$1" | wc -l | tr -d ' '; fi
}

resolve_dir() {
    pkg=$1
    root=./.mint/packages/dataagent
    [ -d "$root" ] || die "no installed dataagent packages under $root — 请在 Mint 项目目录执行 (in the project run: mint add dataagent/preset-intake)"
    dirs=$(installed_dirs "$pkg")
    n=$(count_lines "$dirs")
    [ "$n" -ne 0 ] || die "package dataagent/$pkg is not installed"
    [ "$n" -eq 1 ] || die "dataagent/$pkg has $n installed versions; run \`mint sync\` to match mint.lock"
    printf '%s\n' "$dirs"
}

python_of() {
    dir=$1
    py="$dir/.venv/bin/python"
    [ -x "$py" ] || die "no .venv in $dir (run: dataagent setup)"
    printf '%s\n' "$py"
}

# `dataagent run --case` (07 T30) executes dataagent_runtime.interfaces.bench
# in the data layer: it is the layer that ships dataagent_data's parsing and
# OCR atoms. Look next to this script first — the build/local install product
# and a Mint package tree both place sibling package directories there — then
# fall back to the project's .mint tree.
run_layer_dir() {
    pkg=$1
    self=$0
    case $self in
        */*) ;;
        *) self=$(command -v "$self" 2>/dev/null || printf '%s\n' "$self") ;;
    esac
    base=$(CDPATH= cd -- "$(dirname -- "$self")/../.." 2>/dev/null && pwd) || base=""
    if [ -n "$base" ]; then
        dirs=$(for d in "$base/$pkg" "$base/$pkg"@*; do
            if [ -d "$d" ]; then printf '%s\n' "$d"; fi
        done)
        n=$(count_lines "$dirs")
        [ "$n" -le 1 ] || die "dataagent/$pkg has $n installed versions; run \`mint sync\` to match mint.lock"
        if [ "$n" -eq 1 ]; then
            printf '%s\n' "$dirs"
            return 0
        fi
    fi
    dirs=$(installed_dirs "$pkg")
    n=$(count_lines "$dirs")
    [ "$n" -ne 0 ] || die "package dataagent/$pkg is not installed (build/local or .mint/packages is missing; 请在 Mint 项目目录执行，mint add dataagent/preset-intake)"
    [ "$n" -eq 1 ] || die "dataagent/$pkg has $n installed versions; run \`mint sync\` to match mint.lock"
    printf '%s\n' "$dirs"
}

# The build/local product is shipped as a lockfile bundle, not a Mint project,
# so its first run may not have a .venv yet. Install it from the frozen lock
# before handing the process to it; a real Mint install always has one.
python_for_run() {
    dir=$1
    py="$dir/.venv/bin/python"
    if [ ! -x "$py" ]; then
        command -v uv >/dev/null 2>&1 || die "no .venv in $dir and uv is not on PATH (run: dataagent setup)"
        echo "run: installing $dir (uv sync --frozen)" >&2
        (cd "$dir" && uv sync --frozen) || die "uv sync --frozen failed in $dir"
    fi
    [ -x "$py" ] || die "uv sync did not create $py in $dir"
    printf '%s\n' "$py"
}

# OCR doctor/setup probe (07 §2.3 T20): validates the pin under
# <data_root>/ocr through the data layer venv (dataagent_ocr is its explicit
# dependency) and prints one summary line. Exit 0 = configured local engine,
# with its installation checked (engine kind: engine.lock.json, worker and
# the engine .venv must exist and pass the worker selftest); 1 = missing or
# broken, with the repair command on stderr; 3 = configured but remote — the
# data layer refuses remote OCR until the egress gate lands (T15), so
# scanned-document probes would not work; anything else = the probe itself
# could not run.
OCR_PROBE='
# DATAAGENT_OCR_DOCTOR_PROBE
try:
    from dataagent_ocr.errors import NotConfigured
    from dataagent_ocr.profiles import ProfileStore
except Exception:
    raise SystemExit(2)
import os
import subprocess
import sys
from pathlib import Path
data_root = Path(sys.argv[1])
store = ProfileStore(data_root)
try:
    pin, profile, verification = store.load_pinned()
except NotConfigured:
    print("ocr:      none (run: dataagent setup --ocr-root <verified ocr dir>, or dataagent-ocr configure + verify)", file=sys.stderr)
    raise SystemExit(1)
except Exception as exc:
    code = getattr(exc, "code", type(exc).__name__)
    print(f"ocr:      {code}: {exc} (verify the OCR profile again)", file=sys.stderr)
    raise SystemExit(1)
if profile.kind == "openai_compat":
    name = profile.openai_compat.model
elif profile.kind == "engine":
    name = profile.engine.engine
else:
    name = profile.command.argv[0]
if profile.remote:
    print(f"ocr:      {profile.kind} {name} is remote — the data layer does not use remote OCR before the egress gate (T15); scanned-document probes need a local engine (dataagent-ocr engine install + configure-engine, then dataagent setup --ocr-root)", file=sys.stderr)
    raise SystemExit(3)
if profile.kind == "engine":
    from dataagent_ocr import engines
    cfg = profile.engine
    repair = f"dataagent-ocr engine plan {cfg.engine} / engine install {cfg.engine}, configure-engine --engine {cfg.engine}, verify; then dataagent setup --ocr-root"
    try:
        lock = engines.read_lock(data_root, cfg.engine)
    except Exception as exc:
        print(f"ocr:      engine {cfg.engine} is not installed ({exc}) (run: {repair})", file=sys.stderr)
        raise SystemExit(1)
    if lock["lock_digest"] != cfg.lock_digest:
        print(f"ocr:      engine {cfg.engine} was reinstalled after the profile was created (run: {repair})", file=sys.stderr)
        raise SystemExit(1)
    try:
        spec = engines.EngineSpec.model_validate(lock["spec"])
        worker_digest = engines.current_worker_digest(data_root, spec)
    except Exception as exc:
        print(f"ocr:      worker for {cfg.engine} is missing ({exc}) (run: {repair})", file=sys.stderr)
        raise SystemExit(1)
    if worker_digest != cfg.worker_digest:
        print(f"ocr:      worker for {cfg.engine} changed (run: {repair})", file=sys.stderr)
        raise SystemExit(1)
    argv = engines.worker_argv(data_root, spec, lang=cfg.lang or spec.default_lang) + ["--selftest"]
    env = {k: v for k, v in os.environ.items() if k in {"PATH", "HOME", "LANG", "LC_ALL", "TMPDIR"}}
    try:
        result = subprocess.run(argv, capture_output=True, text=True, timeout=120, env=env,
                                cwd=str(engines.engine_dir(data_root, cfg.engine)))
    except Exception as exc:
        print(f"ocr:      engine environment for {cfg.engine} is not runnable ({type(exc).__name__}) (run: {repair})", file=sys.stderr)
        raise SystemExit(1)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip().splitlines()
        tail = f": {detail[-1]}" if detail else ""
        print(f"ocr:      engine {cfg.engine} failed its selftest{tail} (run: {repair})", file=sys.stderr)
        raise SystemExit(1)
print(f"ocr:      {profile.kind} {name} version={verification.engine_version or pin.ref} verification={verification.verification_id}")
'

# Connections doctor probe (FDE-1): list the configured connections and report
# whether each logical credential reference resolves. The probe reads values
# only to prove they exist; it never prints, stores or returns one. It exits 1
# when any reference is missing, denied by permissions or malformed, so doctor
# collects it as a failing check with the repair hint.
CONNECTION_PROBE='
# DATAAGENT_CONNECTIONS_DOCTOR_PROBE
import sys
from dataagent_workbench.adapters.source_connections import doctor_report
lines, failed = doctor_report(sys.argv[1], sys.argv[2])
for line in lines:
    print(line)
raise SystemExit(1 if failed else 0)
'

# Workbench service probe (FDE-16): report the service bound to this workspace.
# A stale descriptor is reported, not treated as a failing check: the service
# is started on demand.
SERVICE_PROBE='
# DATAAGENT_WORKBENCH_SERVICE_DOCTOR_PROBE
import sys
from dataagent_workbench.launcher import service_status
status = service_status(sys.argv[1])
if status is None:
    print("service:  none for this workspace")
    raise SystemExit(0)
pid = status.get("pid")
url = status.get("url")
if status.get("alive"):
    print(f"service:  workbench pid={pid} url={url} (running)")
else:
    print(f"service:  stale descriptor pid={pid} (run: dataagent workbench stop)")
'

# §5.4: clear every variable unrelated to DataAgent before exec'ing the
# layer process; keep only the whitelist + DATAAGENT_*.
scrub_env() {
    for name in $(env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p'); do
        case $name in
            DATAAGENT_*|PATH|HOME|LANG|LC_*|TZ|TMPDIR|TERM) ;;
            *) unset "$name" 2>/dev/null || true ;;
        esac
    done
}

dispatch() {
    layer=$1
    shift
    pkg=$(layer_pkg "$layer") || die "unknown layer: $layer (data | app | gov | workbench | ops)"
    module=$(module_of "$layer")
    dir=$(resolve_dir "$pkg")
    py=$(python_of "$dir")
    scrub_env
    exec "$py" -m "$module.interfaces.cli" "$@"
}

# run --case (07 T30): the OCR path is part of the call, so carry OCR_ROOT
# across the scrub explicitly instead of widening the shared whitelist.
run_cmd() {
    dir=$(run_layer_dir data-layer)
    py=$(python_for_run "$dir")
    ocr_root=${OCR_ROOT:-}
    scrub_env
    if [ -n "$ocr_root" ]; then
        OCR_ROOT=$ocr_root
        DATAAGENT_OCR_ROOT=${DATAAGENT_OCR_ROOT:-$ocr_root}
        export OCR_ROOT DATAAGENT_OCR_ROOT
    fi
    exec "$py" -m dataagent_runtime.interfaces.bench "$@"
}

link_cmd() {
    target=./dataagent
    if [ -e "$target" ] && ! head -n 2 "$target" 2>/dev/null | grep -qF "$MARKER" 2>/dev/null; then
        echo "dataagent: refusing to overwrite $PWD/dataagent (not a dataagent launcher)" >&2
        exit 2
    fi
    cat "$0" > "$target"
    chmod +x "$target"
    echo "$PWD/dataagent"
}

# install_ocr <dir>: copy a verified OCR directory (active.json, profiles,
# verifications — produced by dataagent-ocr verify) into <data_root>/ocr.
# Idempotent for the same source; refuses to silently replace a different
# pin — switching OCR providers is a verified decision, not a copy.
install_ocr() {
    src=$1
    [ -f "$src/active.json" ] || die "setup: not a verified OCR directory (active.json missing): $src"
    dest_root=${DATAAGENT_DATA_ROOT:-$PWD/.dataagent}
    dest=$dest_root/ocr
    if [ -e "$dest" ]; then
        if [ -f "$dest/active.json" ] && cmp -s "$dest/active.json" "$src/active.json"; then
            echo "setup: ocr already configured at $dest"
            return 0
        fi
        die "setup: $dest already holds a different OCR configuration; switching providers goes through dataagent-ocr verify"
    fi
    mkdir -p "$dest_root"
    cp -R "$src" "$dest" || die "setup: copying $src into $dest failed"
    # Validate the installed pin with the same check doctor runs; roll the
    # copy back when it does not hold up.
    py=$(python_of "$(resolve_dir "data-layer")")
    rc=0
    "$py" -c "$OCR_PROBE" "$dest_root" >/dev/null || rc=$?
    case $rc in
        0) ;;
        3) echo "setup: warning: this OCR provider is remote — the data layer does not use remote OCR before the egress gate (T15); scanned-document probes need a local engine" >&2 ;;
        *) rm -rf "$dest"
           die "setup: the OCR directory at $src did not validate (pin, profile or verification is inconsistent)" ;;
    esac
    echo "setup: ocr configured from $src"
}

setup_cmd() {
    ocr_root=""
    while [ $# -gt 0 ]; do
        case $1 in
            --ocr-root)
                [ $# -ge 2 ] || die "setup: --ocr-root needs a directory argument"
                ocr_root=$2
                shift 2
                ;;
            *) die "setup: unknown argument: $1 (usage: dataagent setup [--ocr-root <dir>])" ;;
        esac
    done
    command -v uv >/dev/null 2>&1 || die "uv not found on PATH; install it or run uv sync inside each layer package"
    for layer in $(active_layers); do
        pkg=$(layer_pkg "$layer")
        dir=$(resolve_dir "$pkg") || exit 3
        echo "setup: $dir"
        (cd "$dir" && uv sync --frozen) || die "uv sync --frozen failed in $dir"
    done
    if [ -n "$ocr_root" ]; then
        install_ocr "$ocr_root"
    fi
    echo "setup: ok"
}

# The project's own [core.sandbox] policy, if it declares one. `mint add`
# never merges this table; the quickstart appends it from preset-intake.
project_sandbox_policy() {
    [ -f mint.toml ] || return 0
    awk '
        /^[[:space:]]*\[core\.sandbox\][[:space:]]*$/ { section=1; next }
        /^[[:space:]]*\[/ { section=0 }
        section && /^[[:space:]]*policy[[:space:]]*=/ {
            value=$0
            sub(/^[^=]*=[[:space:]]*/, "", value)
            gsub(/^"|"[[:space:]]*$/, "", value)
            print value
            exit
        }
    ' mint.toml
}

# doctor: report, don't die — collect every failing check into one exit
# status (3). A missing policy is a failing check, not a success with a
# note (r5-review D14): enforce-mode runs would exit 3 on the next
# --authorize anyway. Connections are checked the same way (FDE-1): an
# unresolvable credential would fail the next probe, so doctor says which
# reference is missing and how to repair it, never its value.
doctor_cmd() {
    status=0
    for layer in $(active_layers); do
        pkg=$(layer_pkg "$layer")
        # Same resolution as resolve_dir: exactly one installed version.
        dir=$(installed_dirs "$pkg")
        n=$(count_lines "$dir")
        if [ "$n" -eq 0 ]; then
            echo "package  dataagent/$pkg: MISSING (in the project run: mint add dataagent/preset-intake)" >&2
            status=3
            continue
        fi
        if [ "$n" -ne 1 ]; then
            echo "package  dataagent/$pkg: $n installed versions (run: mint sync)" >&2
            status=3
            continue
        fi
        echo "package  dataagent/$pkg: $dir"
        if [ -x "$dir/.venv/bin/python" ]; then
            if "$dir/.venv/bin/python" -c "import $(module_of "$layer")" >/dev/null 2>&1; then
                echo "venv     $pkg: ok"
            else
                echo "venv     $pkg: BROKEN import (run: dataagent setup)" >&2
                status=3
            fi
        else
            echo "venv     $pkg: MISSING (run: dataagent setup)" >&2
            status=3
        fi
    done
    root=${DATAAGENT_DATA_ROOT:-$PWD/.dataagent}
    if [ -d "$root" ]; then
        echo "data_root: $root"
    else
        echo "data_root: $root (will be created on first run)"
    fi
    # Connections and credentials (FDE-1). The manifest uses the same lookup
    # as the workbench: an exported DATAAGENT_SOURCE_CONNECTIONS first, then
    # the workspace root source-connections.json, then .dataagent. The probe
    # lists name, kind and manifest path and reports only whether each logical
    # reference resolves; it never outputs a value.
    workspace=${DATAAGENT_WORKSPACE:-$PWD}
    # The workbench owns <workspace>/.dataagent (secrets and the service
    # descriptor), independent of DATAAGENT_DATA_ROOT which drives OCR.
    workbench_root="$workspace/.dataagent"
    workbench_dir=$(installed_dirs workbench)
    if [ "$(count_lines "$workbench_dir")" -eq 1 ] && [ -x "$workbench_dir/.venv/bin/python" ]; then
        rc=0
        connections_out=$("$workbench_dir/.venv/bin/python" -c "$CONNECTION_PROBE" "$workspace" "$workbench_root" 2>&1) || rc=$?
        if [ -n "$connections_out" ]; then
            if [ "$rc" -eq 0 ]; then
                printf '%s\n' "$connections_out"
            else
                printf '%s\n' "$connections_out" >&2
            fi
        fi
        case $rc in
            0) ;;
            1) status=3 ;;
            *) echo "connections: check failed" >&2
               status=3 ;;
        esac
        rc=0
        service_out=$("$workbench_dir/.venv/bin/python" -c "$SERVICE_PROBE" "$workbench_root" 2>&1) || rc=$?
        if [ -n "$service_out" ]; then
            printf '%s\n' "$service_out"
        elif [ "$rc" -ne 0 ]; then
            echo "service:  check failed" >&2
        fi
    else
        echo "connections: not checked (workbench not installed)" >&2
    fi
    # Any other workspace's detached service is reported too (FDE-16), but
    # only with fixed fields: a process command line may contain user input or
    # credential values and must never reach doctor's output.
    if command -v pgrep >/dev/null 2>&1; then
        service_pid=$(printf '%s\n' "${service_out:-}" | sed -n 's/.*pid=\([0-9][0-9]*\).*/\1/p' | head -1)
        shown=0
        for pid in $(pgrep -f 'dataagent_workbench[.]interfaces[.]cli' 2>/dev/null || true); do
            [ "$pid" = "$$" ] && continue
            [ -n "$service_pid" ] && [ "$pid" = "$service_pid" ] && continue
            if [ "$shown" -eq 0 ]; then
                echo "services: other workbench processes (pid only; command lines omitted)"
                shown=1
            fi
            echo "          pid=$pid state=running"
        done
    fi
    # OCR is the data layer's explicit dependency (07 §2.3 T20): the check
    # runs where the data layer is installed and, like the policy check
    # above (r5-review D14), a missing engine is a failing check with the
    # configuration hint — the next scanned document would fail late
    # otherwise. Zero or several data-layer versions are reported above.
    data_dir=$(installed_dirs "data-layer")
    if [ "$(count_lines "$data_dir")" -eq 1 ] && [ -x "$data_dir/.venv/bin/python" ]; then
        rc=0
        "$data_dir/.venv/bin/python" -c "$OCR_PROBE" "$root" || rc=$?
        case $rc in
            0) ;;
            1|3) status=3 ;;
            *) echo "ocr:      check failed" >&2
               status=3 ;;
        esac
    fi
    # The policy probe runs only against a single installed governance
    # layer; zero or several versions are reported above.
    gov_dir=$(installed_dirs "governance-layer")
    [ "$(count_lines "$gov_dir")" -eq 1 ] || gov_dir=""
    if [ -n "$gov_dir" ] && [ -x "$gov_dir/.venv/bin/python" ]; then
        # exit 0 = policy configured, 1 = none, anything else = probe broken
        probe='
try:
    from dataagent_governance.runtime import default_runtime as d
except Exception:
    raise SystemExit(2)
try:
    d().policy.load(None)
except Exception:
    raise SystemExit(1)
'
        rc=0
        "$gov_dir/.venv/bin/python" -c "$probe" >/dev/null 2>&1 || rc=$?
        case $rc in
            0) echo "policy:   configured" ;;
            1) echo "policy:   none (run: dataagent gov policy apply <policy.json>)" >&2
               status=3 ;;
            *) echo "policy:   check failed" >&2
               status=3 ;;
        esac
    elif [ -n "$(installed_dirs workbench)" ] && [ -z "$(installed_dirs governance-layer)" ]; then
        echo "policy:   local-owner workspace only (governance layer not installed)"
    else
        echo "policy:   governance layer unavailable" >&2
        status=3
    fi
    # FDE2-03: the project fragment tightens the effective sandbox to
    # workspace-write/read-only. With a trusted user `approval_policy=never`,
    # Mint's `full-access + never` auto-allow shortcut no longer applies and
    # every tool that needs approval is rejected before it runs. Query only
    # this one policy value; config and credential contents are never printed.
    project_policy=$(project_sandbox_policy)
    if [ -n "$project_policy" ] && [ "$project_policy" != "full-access" ] && command -v mint >/dev/null 2>&1; then
        approval=$(mint config get core.approval_policy 2>/dev/null | sed -n 's/.*= "\([^"]*\)".*/\1/p' | head -1)
        if [ "$approval" = "never" ]; then
            echo "approval: never + project sandbox $project_policy — DataAgent 的 MCP 工具需要审批，never 下会被全部拒绝（FDE2-03）；交互使用先运行: mint config set core.approval_policy on-request（改的是用户级全局设置，影响所有 Mint 项目，评测或演示后可改回 never）" >&2
            status=3
        fi
    fi
    echo "mode:     DATAAGENT_ENFORCEMENT_MODE=${DATAAGENT_ENFORCEMENT_MODE:-warn (default)}"
    if [ "$status" -ne 0 ]; then
        echo "doctor: failing checks above (exit 3)" >&2
    fi
    exit "$status"
}

usage() {
    cat >&2 <<'EOF'
usage: dataagent <layer> <command> [flags]
       dataagent run --case <case.json> --out <dir> --config <cfg.json>
       dataagent link
       dataagent setup [--ocr-root <verified ocr dir>]
       dataagent doctor
       dataagent view [<session id>]
       dataagent workbench serve|list|status <session id>|view [<session id>]|stop

layers: data | app | gov | workbench | ops

layer commands (see `dataagent <layer> <op> --help` for the parameter table):
  dataagent <layer> list                          one line per operation
  dataagent <layer> run <op> --set k=v ...        call an atom
  dataagent <layer> run <op> --file <path>         build a FileRef from bytes
  dataagent <layer> run <op> --ref f=<id@rev>      reuse an earlier result
  dataagent <layer> run <op> --authorize           fill authorization_ref
  dataagent run --case <case.json> --out <dir> --config <cfg.json>
                                                  run one 09-benchmark case
  dataagent gov policy apply <file>                write an access policy
  dataagent gov confirm <file>                     confirm acceptance criteria
  dataagent workbench serve [--port <n>]           start this workspace service
  dataagent workbench list                         tasks, phases and releases
  dataagent workbench status <session id>          task status
  dataagent workbench view [<session id>]          open a task, or print the
                                                   home page URL with no task
  dataagent workbench stop                         stop this workspace service
  dataagent view [<session id>]                    same as `workbench view`;
                                                   no id prints the home page URL

stdout is a summary JSON (status, issues, handles, result_path); the full
result lands in .dataagent/results/<invocation_id>.json. exit: 0 ok/partial/
needs_input, 1 failed, 2 usage, 3 environment missing.
EOF
    exit 2
}

active_layers() {
    if [ -n "$(installed_dirs workbench)" ]; then
        for layer in data app gov workbench ops; do
            [ -z "$(installed_dirs "$(layer_pkg "$layer")")" ] || printf '%s\n' "$layer"
        done
    else
        printf '%s\n' $LAYERS
    fi
}

[ $# -ge 1 ] || usage
case $1 in
    data|app|gov|workbench|ops) dispatch "$@" ;;
    run) shift; run_cmd "$@" ;;
    link) [ $# -eq 1 ] && link_cmd || usage ;;
    setup) shift; setup_cmd "$@" ;;
    doctor) [ $# -eq 1 ] && doctor_cmd || usage ;;
    view) shift; dispatch workbench view "$@" ;;
    -h|--help|help) usage ;;
    *) usage ;;
esac
