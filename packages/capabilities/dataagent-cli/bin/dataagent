#!/bin/sh
# dataagent unified CLI dispatcher (12-unified-cli-research §5.1/§5.3).
#
# Dispatches `dataagent <layer> ...` to the sibling layer package's in-package
# .venv interpreter — the three layers are never loaded in one process
# (governance pins duckdb<2 / sqlglot<27, application pins duckdb 2.0.0 /
# sqlglot 30.29). Before exec the ambient environment is scrubbed down to a
# whitelist (§5.4): credentials that happen to live in the host environment
# never reach the layer process.
#
# Commands:
#   dataagent <data|app|gov> ...    layer dispatch (list / run / --help / ...)
#   dataagent link                 generate ./dataagent in the project root
#   dataagent setup                uv sync --frozen for all three layers
#   dataagent doctor               check packages, .venv, policy, data_root, mode
#
# POSIX sh only, no Python dependency.

set -eu

MARKER='# dataagent unified CLI dispatcher'
LAYERS="data app gov"
MODULE_data=dataagent_data
MODULE_application=dataagent_application
MODULE_governance=dataagent_governance

die() { echo "dataagent: $*" >&2; exit 3; }

layer_pkg() {
    case $1 in
        data) echo "data-layer" ;;
        app) echo "application-layer" ;;
        gov) echo "governance-layer" ;;
        *) return 1 ;;
    esac
}

module_of() {
    case $1 in
        data) echo "$MODULE_data" ;;
        app) echo "$MODULE_application" ;;
        gov) echo "$MODULE_governance" ;;
        *) return 1 ;;
    esac
}

# Version pinned in mint.lock wins; without a pin the highest installed
# version is used (12 §5.1: 按 mint.lock 取版本). A pin that is not
# installed is an environment error (exit 3) — never silently fall back
# to another version (r5-review D13). A lock that has no entry for this
# layer is simply "no pin" for this layer (r6-review D16): an installed
# layer must resolve exactly like the no-lock case.
#
# pinned_version never dies and never prints on its "no pin" paths; its
# exit status is consumed with `||` (NOT inside `if` — a die in an if
# condition is swallowed by the subshell and would fail open, which is
# exactly the r7-review D16 regression):
#   0  this layer is pinned (version on stdout)
#   1  no mint.lock, or no entry for this package — callers fall back
#      to the highest installed version
#   2  mint.lock has an entry for this package whose version cannot be
#      read — a corrupt lock; callers must fail closed (exit 3)
#
# The lock is parsed with a TOML subset (POSIX awk, no Python) that
# follows the real Mint lock structure (r8-review D16):
#   - table scope: only `[[package]]` (or `[package]`) entries hold
#     package pins; `[[package.requires]]` dependency edges and any
#     other table (`[core]`, `[package.artifacts.any]`, …) may carry
#     name/version keys that must be ignored, never read as a pin —
#     when a requires edge precedes the real package entry the pin
#     must still come from that entry;
#   - quoted keys (`"name" = …` / `'name' = …`) are the same keys;
#   - basic strings are unescaped (`\\ \" \b \f \n \r \t \uXXXX
#     \UXXXXXXXX`), so "dataagent\u002fdata-layer" pins the same
#     package as `dataagent/data-layer` and "0\u002e1.0" the same
#     version as `0.1.0`;
#   - anything but whitespace or a `#` comment after the closing
#     quote makes the value unreadable (fail closed), and an entry
#     whose name cannot be parsed might be this package, so it also
#     fails closed — never a silent fall back to the highest
#     installed version.
pinned_version() {
    pkg=$1
    [ -f ./mint.lock ] || return 1
    ver=""
    rc=0
    # sq is a single quote, passed via -v so the program body carries no
    # quote that would end the shell's single-quoted awk argument.
    ver=$(awk -v want="dataagent/$pkg" -v sq="'" '
        BEGIN { mode = "other"; nameok = 1 }
        function hexval(h,  i, c, d, n) {
            n = 0
            for (i = 1; i <= length(h); i++) {
                c = tolower(substr(h, i, 1))
                d = index("0123456789abcdef", c) - 1
                if (d < 0) return -1
                n = n * 16 + d
            }
            return n
        }
        # code point -> UTF-8 bytes (ASCII fast path covers real locks)
        function utf8(cp) {
            if (cp < 128) return sprintf("%c", cp)
            if (cp < 2048) return sprintf("%c%c", 192 + int(cp / 64), 128 + cp % 64)
            if (cp < 65536) return sprintf("%c%c%c", 224 + int(cp / 4096), 128 + int(cp / 64) % 64, 128 + cp % 64)
            return sprintf("%c%c%c%c", 240 + int(cp / 262144), 128 + int(cp / 4096) % 64, 128 + int(cp / 64) % 64, 128 + cp % 64)
        }
        # Parse the value after `=` (s has leading blanks stripped) as a
        # basic "…" / literal '\''…'\'' string (single-line; triple-quote
        # forms accepted). Sets vok = 1 only for a complete, well-formed
        # value with just whitespace or a comment after the closing
        # quote; returns the decoded text.
        function value(s,  q, t, ml, i, c, h, cp, closed, tail) {
            vok = 0
            q = substr(s, 1, 1)
            if (q != "\"" && q != sq) return ""
            t = q q q
            ml = (substr(s, 1, 3) == t)
            i = ml ? 4 : 2
            val = ""
            closed = 0
            while (i <= length(s)) {
                c = substr(s, i, 1)
                if (c == q) {
                    if (! ml || substr(s, i, 3) == t) {
                        i += ml ? 3 : 1
                        closed = 1
                        break
                    }
                    val = val c
                    i++
                    continue
                }
                if (q == sq || c != "\\") {
                    val = val c
                    i++
                    continue
                }
                # basic-string escape sequence
                c = substr(s, i + 1, 1)
                if (c == "n") { val = val "\n"; i += 2 }
                else if (c == "t") { val = val "\t"; i += 2 }
                else if (c == "r") { val = val "\r"; i += 2 }
                else if (c == "b") { val = val "\b"; i += 2 }
                else if (c == "f") { val = val "\f"; i += 2 }
                else if (c == "\"") { val = val "\""; i += 2 }
                else if (c == "\\") { val = val "\\"; i += 2 }
                else if (c == "u" || c == "U") {
                    h = substr(s, i + 2, c == "u" ? 4 : 8)
                    cp = hexval(h)
                    if (length(h) != (c == "u" ? 4 : 8) || cp < 0) return ""
                    val = val utf8(cp)
                    i += 2 + length(h)
                }
                else return ""
                continue
            }
            if (! closed) return ""
            tail = substr(s, i)
            sub(/^[ \t\r]+/, "", tail)
            if (tail != "" && substr(tail, 1, 1) != "#") return ""
            vok = 1
            return val
        }
        # A table header ends the previous entry; evaluate it against
        # want exactly once (first matching entry wins). Only the
        # package array itself is a package entry — the nested
        # [[package.requires]] dependency edges are not (r8-review D16).
        function flush() {
            if (mode == "pkg" && ! seen) {
                if (! nameok) bad = 1
                else if (name == want) {
                    seen = 1
                    if (! verok || ver == "") bad = 1
                    else { print ver; got = 1 }
                }
            }
            name = ""
            ver = ""
            nameok = 1
            verok = 0
        }
        /^[[:space:]]*\[/ {
            flush()
            hdr = $0
            sub(/#.*/, "", hdr)
            gsub(/[[:space:]]/, "", hdr)
            mode = (hdr == "[[package]]" || hdr == "[package]") ? "pkg" : "other"
            next
        }
        # key = "value" | key="value" | quoted keys | literal values with
        # any leading indentation; only name/version matter, only inside
        # a package entry.
        mode == "pkg" && index($0, "=") > 0 {
            eq = index($0, "=")
            key = substr($0, 1, eq - 1)
            sub(/^[[:space:]]+/, "", key)
            sub(/[[:space:]]+$/, "", key)
            if (substr(key, 1, 1) == "\"" || substr(key, 1, 1) == sq) {
                kq = substr(key, 1, 1)
                k = substr(key, 2)
                if (substr(k, length(k), 1) == kq) key = substr(k, 1, length(k) - 1)
                else bad = 1
            }
            if (key != "name" && key != "version") next
            s = substr($0, eq + 1)
            sub(/^[[:space:]]+/, "", s)
            v = value(s)
            if (key == "name") { name = v; nameok = vok }
            else { ver = v; verok = vok }
        }
        END { flush(); exit bad ? 2 : (got ? 0 : 1) }
    ' ./mint.lock) || rc=$?
    case $rc in
        0) printf '%s\n' "$ver"; return 0 ;;
        1) return 1 ;;
        *) return 2 ;;
    esac
}

# Shared capture of pinned_version's three-way outcome (r7-review D16):
# sets pin_ver / pin_rc. Callers MUST consume pin_rc — 2 (unreadable
# lock entry) has to fail closed (die in dispatch paths, a failing
# doctor check) and must never fall through to highest-installed.
pin_status() {
    pkg=$1
    pin_rc=0
    pin_ver=$(pinned_version "$pkg") || pin_rc=$?
}

resolve_dir() {
    pkg=$1
    root=./.mint/packages/dataagent
    [ -d "$root" ] || die "no installed dataagent packages under $root (mint add dataagent/preset-s0)"
    dir=""
    pin_status "$pkg"
    [ "$pin_rc" -ne 2 ] || die "mint.lock has an entry for dataagent/$pkg without a readable version (regenerate mint.lock)"
    if [ "$pin_rc" -eq 0 ]; then
        [ -d "$root/$pkg@$pin_ver" ] || die "mint.lock pins dataagent/$pkg@$pin_ver but that version is not installed (mint add dataagent/preset-s0)"
        dir="$root/$pkg@$pin_ver"
    fi
    if [ -z "$dir" ]; then
        dir=$(ls -d "$root/$pkg@"* 2>/dev/null | sort -V | tail -1) || dir=""
    fi
    [ -n "$dir" ] || die "package dataagent/$pkg is not installed"
    printf '%s\n' "$dir"
}

python_of() {
    dir=$1
    py="$dir/.venv/bin/python"
    [ -x "$py" ] || die "no .venv in $dir (run: dataagent setup)"
    printf '%s\n' "$py"
}

# §5.4: clear every variable unrelated to DataAgent before exec'ing the
# layer process; keep only the whitelist + DATAAGENT_*.
scrub_env() {
    for name in $(env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p'); do
        case $name in
            DATAAGENT_*|PATH|HOME|LANG|LC_*|TZ|TMPDIR|TERM) ;;
            *) unset "$name" 2>/dev/null || true ;;
        esac
    done
}

dispatch() {
    layer=$1
    shift
    pkg=$(layer_pkg "$layer") || die "unknown layer: $layer (data | app | gov)"
    module=$(module_of "$layer")
    dir=$(resolve_dir "$pkg")
    py=$(python_of "$dir")
    scrub_env
    exec "$py" -m "$module.interfaces.cli" "$@"
}

link_cmd() {
    target=./dataagent
    if [ -e "$target" ] && ! head -n 2 "$target" 2>/dev/null | grep -qF "$MARKER" 2>/dev/null; then
        echo "dataagent: refusing to overwrite $PWD/dataagent (not a dataagent launcher)" >&2
        exit 2
    fi
    cat "$0" > "$target"
    chmod +x "$target"
    echo "$PWD/dataagent"
}

setup_cmd() {
    command -v uv >/dev/null 2>&1 || die "uv not found on PATH; install it or run uv sync inside each layer package"
    for layer in $LAYERS; do
        pkg=$(layer_pkg "$layer")
        dir=$(resolve_dir "$pkg") || exit 3
        echo "setup: $dir"
        (cd "$dir" && uv sync --frozen) || die "uv sync --frozen failed in $dir"
    done
    echo "setup: ok"
}

# doctor: report, don't die — collect every failing check into one exit
# status (3). A missing policy is a failing check, not a success with a
# note (r5-review D14): enforce-mode runs would exit 3 on the next
# --authorize anyway.
doctor_cmd() {
    status=0
    for layer in $LAYERS; do
        pkg=$(layer_pkg "$layer")
        dir=""
        # Same resolution order as resolve_dir (r6-review D16): pin when
        # mint.lock pins this layer (and it is installed), otherwise the
        # highest installed version — never a missing-pin rejection. An
        # unreadable pin is a failing check, not a fallback (r7-review
        # D16): dispatch would exit 3 on the same lock.
        pin_status "$pkg"
        case $pin_rc in
            0)
                if [ ! -d "./.mint/packages/dataagent/$pkg@$pin_ver" ]; then
                    echo "package  dataagent/$pkg: MISSING pinned $pin_ver (mint add dataagent/preset-s0)" >&2
                    status=3
                    continue
                fi
                dir="./.mint/packages/dataagent/$pkg@$pin_ver"
                ;;
            1) ;;
            *)
                echo "package  dataagent/$pkg: LOCK unreadable (regenerate mint.lock)" >&2
                status=3
                continue
                ;;
        esac
        if [ -z "$dir" ]; then
            dir=$(ls -d "./.mint/packages/dataagent/$pkg@"* 2>/dev/null | sort -V | tail -1) || dir=""
        fi
        if [ -z "$dir" ]; then
            echo "package  dataagent/$pkg: MISSING (mint add dataagent/preset-s0)" >&2
            status=3
            continue
        fi
        echo "package  dataagent/$pkg: $dir"
        if [ -x "$dir/.venv/bin/python" ]; then
            if "$dir/.venv/bin/python" -c "import $(module_of "$layer")" >/dev/null 2>&1; then
                echo "venv     $pkg: ok"
            else
                echo "venv     $pkg: BROKEN import (run: dataagent setup)" >&2
                status=3
            fi
        else
            echo "venv     $pkg: MISSING (run: dataagent setup)" >&2
            status=3
        fi
    done
    root=${DATAAGENT_DATA_ROOT:-$PWD/.dataagent}
    if [ -d "$root" ]; then
        echo "data_root: $root"
    else
        echo "data_root: $root (will be created on first run)"
    fi
    gov_dir=""
    # Same three-way pin outcome for the policy probe (r7-review D16):
    # unreadable pin → no dir → "governance layer unavailable" instead
    # of probing a bypassed version.
    pin_status "governance-layer"
    case $pin_rc in
        0) gov_dir="./.mint/packages/dataagent/governance-layer@$pin_ver" ;;
        1) gov_dir=$(ls -d ./.mint/packages/dataagent/governance-layer@* 2>/dev/null | sort -V | tail -1) || gov_dir="" ;;
    esac
    if [ -n "$gov_dir" ] && [ -x "$gov_dir/.venv/bin/python" ]; then
        # exit 0 = policy configured, 1 = none, anything else = probe broken
        probe='
try:
    from dataagent_governance.runtime import default_runtime as d
except Exception:
    raise SystemExit(2)
try:
    d().policy.load(None)
except Exception:
    raise SystemExit(1)
'
        rc=0
        "$gov_dir/.venv/bin/python" -c "$probe" >/dev/null 2>&1 || rc=$?
        case $rc in
            0) echo "policy:   configured" ;;
            1) echo "policy:   none (run: dataagent gov policy apply <policy.json>)" >&2
               status=3 ;;
            *) echo "policy:   check failed" >&2
               status=3 ;;
        esac
    else
        echo "policy:   governance layer unavailable" >&2
        status=3
    fi
    echo "mode:     DATAAGENT_ENFORCEMENT_MODE=${DATAAGENT_ENFORCEMENT_MODE:-warn (default)}"
    if [ "$status" -ne 0 ]; then
        echo "doctor: failing checks above (exit 3)" >&2
    fi
    exit "$status"
}

usage() {
    cat >&2 <<'EOF'
usage: dataagent <layer> <command> [flags]
       dataagent link
       dataagent setup
       dataagent doctor

layers: data | app | gov

layer commands (see `dataagent <layer> <op> --help` for the parameter table):
  dataagent <layer> list                          one line per operation
  dataagent <layer> run <op> --set k=v ...        call an atom
  dataagent <layer> run <op> --file <path>         build a FileRef from bytes
  dataagent <layer> run <op> --ref f=<id@rev>      reuse an earlier result
  dataagent <layer> run <op> --authorize           fill authorization_ref
  dataagent gov policy apply <file>                write an access policy
  dataagent gov confirm <file>                     confirm acceptance criteria

stdout is a summary JSON (status, issues, handles, result_path); the full
result lands in .dataagent/results/<invocation_id>.json. exit: 0 ok/partial/
needs_input, 1 failed, 2 usage, 3 environment missing.
EOF
    exit 2
}

[ $# -ge 1 ] || usage
case $1 in
    data|app|gov) dispatch "$@" ;;
    link) [ $# -eq 1 ] && link_cmd || usage ;;
    setup) [ $# -eq 1 ] && setup_cmd || usage ;;
    doctor) [ $# -eq 1 ] && doctor_cmd || usage ;;
    -h|--help|help) usage ;;
    *) usage ;;
esac
