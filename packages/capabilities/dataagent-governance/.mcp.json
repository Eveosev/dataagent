{
  "mcpServers": {
    "dataagent-governance": {
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--project",
        "$PKG",
        "python",
        "-m",
        "dataagent_governance.interfaces.mcp_server"
      ],
      "env": {
        "DATAAGENT_ENFORCEMENT_MODE": "enforce"
      },
      "timeout_s": 120
    }
  }
}
