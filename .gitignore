# AgentOS source baseline .gitignore
# 仓库此前无版本控制（见 docs/research/dataagent-2026-11-03/12-cli-build/ r2/r3 记录）。
# 本 .gitignore 只排除易变/生成/超大目录，源码与文档全部入库：
# 排除项均为运行产物或本地状态，不是源码基线的一部分。

# macOS / 编辑器
.DS_Store
.claude/
.cursor/

# Python 运行产物
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.tox/
.eggs/
.venv/
venv/

# Node 运行产物
node_modules/

# 本地 Mint / 工具状态
.mint/
.tmp_research/
.lark-report/
.lark-upload/
.pytest_cache/

# 运行工作区与产物（非源码；含 .dataagent 运行数据）
workspace/
.dataagent/
.dataagent*/

# 大体积运行证据与草稿（记录另行归档，不入源码基线）
evidence/
draft_*/

# agent 内部 worktree（自身携带 .git，属 agent-kernel 的检出）
.worktrees/

# 本机 Agent 工作区大文件
scratch/
