{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.local/benchmark/task.schema.json",
  "title": "Benchmark task card",
  "type": "object",
  "required": [
    "id",
    "slug",
    "title",
    "plan_row",
    "catalog_atoms",
    "slice",
    "unit",
    "graders",
    "metrics",
    "gate",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^B(0[1-9]|1[0-9]|20)$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "plan_row": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "plan_ref": {
      "type": "string"
    },
    "catalog_atoms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^DA[0-9]{2}\\.[0-9]+\\.[0-9]+$"
      }
    },
    "slice": {
      "enum": [
        "S0",
        "S1",
        "S2",
        "按需",
        "S0 / 按需"
      ]
    },
    "unit": {
      "enum": [
        "table",
        "page",
        "document",
        "clause_set",
        "question",
        "query",
        "task",
        "series",
        "scenario",
        "case",
        "pipeline",
        "engagement"
      ]
    },
    "why_not_unit_tested": {
      "type": "string"
    },
    "reference_benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "scale_note": {
            "type": "string"
          }
        }
      }
    },
    "dataset": {
      "type": "object",
      "required": [
        "sources",
        "manifest_ref",
        "refresh"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "composition": {
          "type": "string"
        },
        "manifest_ref": {
          "type": "string",
          "pattern": "^dataset/manifest\\.json$"
        },
        "refresh": {
          "type": "object",
          "required": [
            "unseen_acceptance_every_rounds",
            "replace_ratio",
            "rule"
          ],
          "properties": {
            "unseen_acceptance_every_rounds": {
              "type": "integer",
              "minimum": 1
            },
            "replace_ratio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "rule": {
              "type": "string"
            }
          }
        }
      }
    },
    "graders": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "direction",
          "primary",
          "unit",
          "aggregation",
          "grader",
          "threshold_status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "higher",
              "lower"
            ]
          },
          "primary": {
            "type": "boolean"
          },
          "unit": {
            "type": "string"
          },
          "aggregation": {
            "enum": [
              "mean_over_cases",
              "median_over_series",
              "pooled",
              "sum"
            ]
          },
          "grader": {
            "type": "string"
          },
          "threshold_status": {
            "enum": [
              "pending_baseline",
              "set"
            ]
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "tier",
        "in_ci",
        "blocking_metrics",
        "ref"
      ],
      "properties": {
        "tier": {
          "enum": [
            "block",
            "guard",
            "warn",
            "field"
          ]
        },
        "in_ci": {
          "type": "boolean"
        },
        "blocking_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "ref": {
          "type": "string"
        }
      }
    },
    "status": {
      "enum": [
        "planned",
        "collecting",
        "baselining",
        "active",
        "frozen",
        "deprecated"
      ]
    },
    "owner": {
      "type": "string"
    },
    "notes_ref": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "scope_note": {
      "type": "string"
    }
  }
}
