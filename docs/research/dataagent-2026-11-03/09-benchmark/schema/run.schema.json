{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentos.local/benchmark/run.schema.json",
  "title": "Run record",
  "type": "object",
  "required": [
    "run_id",
    "round_id",
    "task_id",
    "status",
    "env",
    "dataset_ref",
    "samples",
    "started_at"
  ],
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[rx][0-9]{3}-[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "round_id": {
      "type": "string",
      "pattern": "^[rx][0-9]{3}-[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^B(0[1-9]|1[0-9]|20)$"
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "scored",
        "failed",
        "skipped"
      ]
    },
    "env": {
      "type": "object",
      "required": [
        "adapter",
        "model"
      ],
      "properties": {
        "adapter": {
          "type": "string"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent_kernel": {
          "type": [
            "string",
            "null"
          ]
        },
        "dataagent": {
          "type": [
            "string",
            "null"
          ]
        },
        "harness": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "dataset_ref": {
      "type": "object",
      "required": [
        "revision",
        "splits"
      ],
      "properties": {
        "revision": {
          "type": "string"
        },
        "splits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "samples": {
      "type": "object",
      "required": [
        "total",
        "scored",
        "missing"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "scored": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "cost": {
      "type": [
        "object",
        "null"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
