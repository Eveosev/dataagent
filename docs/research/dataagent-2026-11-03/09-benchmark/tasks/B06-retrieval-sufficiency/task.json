{
  "id": "B06",
  "slug": "retrieval-sufficiency",
  "title": "召回检索与检索充分性",
  "plan_row": 6,
  "plan_ref": "../../../09-benchmark-plan.md",
  "catalog_atoms": [
    "DA05.1.1",
    "DA05.1.2",
    "DA05.1.3",
    "DA05.2.1",
    "DA05.2.2",
    "DA05.2.3",
    "DA05.2.4",
    "DA05.4.1",
    "DA05.4.2",
    "DA05.6.1",
    "DA05.6.2",
    "DA05.9.1",
    "DA05.9.2",
    "DA05.9.3",
    "DA05.9.4"
  ],
  "slice": "按需",
  "unit": "query",
  "why_not_unit_tested": "漏召回无法归因、停止时机只有整链跑起来才可测",
  "reference_benchmarks": [
    {
      "name": "BRIGHT",
      "url": "https://arxiv.org/abs/2407.12883",
      "scale_note": "1,398 个推理型检索查询；最佳 nDCG@10 低于 30"
    },
    {
      "name": "TARGET",
      "url": "https://arxiv.org/abs/2505.11545",
      "scale_note": "表检索，接 FeTaQA / TabFACT / OTT-QA / Spider / BIRD"
    }
  ],
  "dataset": {
    "sources": [
      "BRIGHT",
      "TARGET",
      "自建表 / 文档混检集"
    ],
    "composition": "检索指标与下游答案分别报；停止时漏召回必须单列，不能混进 Recall",
    "manifest_ref": "dataset/manifest.json",
    "refresh": {
      "unseen_acceptance_every_rounds": 6,
      "replace_ratio": 0.25,
      "rule": "样本一经暴露即降级为 regression；unseen_acceptance 不得参与调参"
    }
  },
  "graders": [
    "ndcg",
    "recall_k",
    "retrieval_stop_audit",
    "step_audit"
  ],
  "metrics": [
    {
      "id": "recall_at_k",
      "label": "Recall@k（k=10）",
      "direction": "higher",
      "primary": true,
      "unit": "ratio",
      "aggregation": "mean_over_cases",
      "grader": "recall_k",
      "threshold_status": "pending_baseline"
    },
    {
      "id": "ndcg_at_10",
      "label": "nDCG@10",
      "direction": "higher",
      "primary": false,
      "unit": "ratio",
      "aggregation": "mean_over_cases",
      "grader": "ndcg",
      "threshold_status": "pending_baseline"
    },
    {
      "id": "miss_on_stop_rate",
      "label": "停止时漏召回率",
      "direction": "lower",
      "primary": false,
      "unit": "ratio",
      "aggregation": "mean_over_cases",
      "grader": "retrieval_stop_audit",
      "threshold_status": "pending_baseline"
    },
    {
      "id": "redundant_step_rate",
      "label": "多余检索步数（相对最优）",
      "direction": "lower",
      "primary": false,
      "unit": "ratio",
      "aggregation": "mean_over_cases",
      "grader": "step_audit",
      "threshold_status": "pending_baseline"
    }
  ],
  "gate": {
    "tier": "warn",
    "in_ci": true,
    "blocking_metrics": [
      "recall_at_k"
    ],
    "ref": "../../monitor/thresholds.json"
  },
  "status": "collecting",
  "owner": "TBD",
  "notes_ref": "NOTES.md",
  "created": "2026-11-04"
}
