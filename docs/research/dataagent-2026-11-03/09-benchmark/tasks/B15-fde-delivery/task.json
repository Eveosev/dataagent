      "aggregation": "mean_over_cases",
      "grader": "field_log_aggregate",
      "threshold_status": "pending_baseline"
    },
    {
      "id": "approval_burden",
      "label": "审批负担（次/任务）",
      "direction": "lower",
      "primary": false,
      "unit": "count",
      "aggregation": "mean_over_cases",
      "grader": "field_log_aggregate",
      "threshold_status": "pending_baseline"
