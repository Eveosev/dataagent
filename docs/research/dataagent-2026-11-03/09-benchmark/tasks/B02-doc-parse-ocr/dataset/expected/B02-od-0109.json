    {
      "category": "title",
      "order": 18,
      "text": "# 一 陈述语气"
    },
    {
      "category": "text_block",
      "order": 20,
      "text": "陈述语气表示所说的话是陈述事实、提出想法。"
    },
    {
      "category": "text_block",
      "order": 21,
      "text": "陈述语气可以用于各种时态，多用于陈述句、疑问句及部分感叹句中。"
    },
    {
      "category": "text_block",
      "order": 22,
      "text": "She went to the office this morning."
    },
    {
      "category": "text_block",
      "order": 23,
      "text": "她今天早上去了办公室。"
    },
    {
      "category": "text_block",
      "order": 24,
      "text": "How nice a man he is!"
    },
    {
      "category": "text_block",
      "order": 25,
      "text": "他是多好的一个人啊！"
    },
