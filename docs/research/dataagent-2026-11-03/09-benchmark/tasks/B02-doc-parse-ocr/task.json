{
  "id": "B02",
  "slug": "doc-parse-ocr",
  "title": "文档解析与 OCR",
  "plan_row": 2,
  "plan_ref": "../../../09-benchmark-plan.md",
  "catalog_atoms": [
    "DA01.4.5",
    "DA01.5.1",
    "DA01.5.2",
    "DA02.8.1",
    "DA02.8.2"
  ],
  "slice": "S0",
  "unit": "page",
  "why_not_unit_tested": "扫描件、盖章件、复杂版面的退化只在真实文档分布上出现；合成样本会低估版面错乱",
  "reference_benchmarks": [
    {
      "name": "OmniDocBench",
      "url": "https://github.com/shijinpjlab/OmniDocBench",
      "scale_note": "v1.5 共 1,355 页；NED、TEDS；头部模型已 >95"
    },
    {
      "name": "olmOCR-Bench",
      "url": "https://github.com/allenai/olmocr/tree/main/olmocr/bench",
      "scale_note": "单页 PDF，逐条事实断言按通过比例计分"
    }
  ],
  "dataset": {
    "sources": [
      "OmniDocBench",
      "olmOCR-Bench",
      "脱敏扫描件 / 盖章件"
    ],
    "composition": "以 olmOCR-Bench 式断言为主判分；OmniDocBench 已接近饱和，只作上限标定不进门槛",
    "manifest_ref": "dataset/manifest.json",
    "refresh": {
      "unseen_acceptance_every_rounds": 6,
      "replace_ratio": 0.25,
      "rule": "样本一经暴露即降级为 regression；unseen_acceptance 不得参与调参"
    }
  },
  "graders": [
    "assertion_pass_rate",
    "ned_edit_distance",
    "order_accuracy",
    "teds"
  ],
  "metrics": [
    {
      "id": "text_ned",
      "label": "文本 NED",
      "direction": "lower",
      "primary": true,
      "unit": "ratio",
      "aggregation": "mean_over_cases",
      "grader": "ned_edit_distance",
      "threshold_status": "pending_baseline"
    },
    {
      "id": "table_teds",
      "label": "表格 TEDS",
      "direction": "higher",
      "primary": false,
      "unit": "ratio",
      "aggregation": "mean_over_cases",
      "grader": "teds",
      "threshold_status": "pending_baseline"
    },
    {
      "id": "reading_order_accuracy",
      "label": "阅读顺序准确率",
      "direction": "higher",
      "primary": false,
      "unit": "ratio",
      "aggregation": "mean_over_cases",
      "grader": "order_accuracy",
      "threshold_status": "pending_baseline"
    },
    {
      "id": "assertion_pass_rate",
      "label": "断言通过率",
      "direction": "higher",
      "primary": false,
      "unit": "ratio",
      "aggregation": "mean_over_cases",
      "grader": "assertion_pass_rate",
      "threshold_status": "pending_baseline"
    }
  ],
  "gate": {
    "tier": "block",
    "in_ci": true,
    "blocking_metrics": [
      "text_ned"
    ],
    "ref": "../../monitor/thresholds.json"
  },
  "status": "collecting",
  "owner": "TBD",
  "notes_ref": "NOTES.md",
  "created": "2026-11-04"
}
