{
  "id": "B08",
  "slug": "forecast-optimization",
  "title": "预测与优化",
  "plan_row": 8,
  "plan_ref": "../../../09-benchmark-plan.md",
  "catalog_atoms": [
    "DA09.1.1",
    "DA09.1.2",
    "DA09.1.3",
    "DA09.2.1",
    "DA09.2.2",
    "DA09.3.1",
    "DA09.3.2",
    "DA09.4.1",
    "DA09.4.2"
  ],
  "slice": "按需",
  "unit": "task",
  "why_not_unit_tested": "预测需结合文本上下文；求解结果要区分最优、可行、未知，三者混淆在单测里看不出来",
  "reference_benchmarks": [
    {
      "name": "Context is Key",
      "url": "https://arxiv.org/abs/2410.18959",
      "scale_note": "71 个预测任务 / 7 领域，每题必须用到文本上下文"
    },
    {
      "name": "OptiBench",
      "url": "https://arxiv.org/abs/2407.09887",
      "scale_note": "求解代码执行后比对目标值"
    },
    {
      "name": "OptiMATH / 综述",
      "url": "https://arxiv.org/pdf/2509.22979",
      "scale_note": "原数据有质量问题，用清洗版"
    }
  ],
  "dataset": {
    "sources": [
      "Context is Key",
      "NL4Opt / IndustryOR / OptiBench / OptMATH（清洗版）"
    ],
    "composition": "全部使用清洗版；预测与优化分开汇总，避免 CRPS 掩盖求解失败",
    "manifest_ref": "dataset/manifest.json",
    "refresh": {
      "unseen_acceptance_every_rounds": 6,
      "replace_ratio": 0.25,
      "rule": "样本一经暴露即降级为 regression；unseen_acceptance 不得参与调参"
    }
  },
  "graders": [
    "crps",
    "feasibility_classification",
    "smape",
    "solver_objective_match"
  ],
  "metrics": [
    {
      "id": "crps",
      "label": "CRPS",
      "direction": "lower",
      "primary": false,
      "unit": "score",
      "aggregation": "mean_over_cases",
      "grader": "crps",
      "threshold_status": "pending_baseline"
    },
    {
      "id": "smape",
      "label": "SMAPE",
      "direction": "lower",
      "primary": true,
      "unit": "ratio",
      "aggregation": "mean_over_cases",
      "grader": "smape",
      "threshold_status": "pending_baseline"
    },
    {
      "id": "objective_value_accuracy",
      "label": "求解目标值准确率",
      "direction": "higher",
      "primary": false,
      "unit": "ratio",
      "aggregation": "mean_over_cases",
      "grader": "solver_objective_match",
      "threshold_status": "pending_baseline"
    },
    {
      "id": "feasibility_class_accuracy",
      "label": "最优 / 可行 / 未知判定准确率",
      "direction": "higher",
      "primary": false,
      "unit": "ratio",
      "aggregation": "mean_over_cases",
      "grader": "feasibility_classification",
      "threshold_status": "pending_baseline"
    }
  ],
  "gate": {
    "tier": "warn",
    "in_ci": true,
    "blocking_metrics": [
      "smape"
    ],
    "ref": "../../monitor/thresholds.json"
  },
  "status": "collecting",
  "owner": "TBD",
  "notes_ref": "NOTES.md",
  "created": "2026-11-04"
}
