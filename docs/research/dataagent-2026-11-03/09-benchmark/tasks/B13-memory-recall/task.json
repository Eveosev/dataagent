{
  "id": "B13",
  "slug": "memory-recall",
  "title": "记忆与经验召回",
  "plan_row": 13,
  "plan_ref": "../../../09-benchmark-plan.md",
  "catalog_atoms": [
    "DA04.3.1",
    "DA04.3.2",
    "DA04.3.3",
    "DA05.3.1",
