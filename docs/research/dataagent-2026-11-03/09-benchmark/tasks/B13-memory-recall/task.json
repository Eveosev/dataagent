    "DA05.3.4",
    "DA12.3.1",
    "DA12.3.2",
    "DA12.3.3",
    "DA12.3.4"
  ],
  "slice": "按需",
  "unit": "question",
  "why_not_unit_tested": "知识更新后仍用旧信息、时序推理，只在多会话序列里出现",
  "reference_benchmarks": [
    {
      "name": "LongMemEval v2",
      "url": "https://arxiv.org/abs/2605.12493",
      "scale_note": "信息抽取、多会话推理、知识更新、时序推理、拒答"
    },
    {
      "name": "MemoryAgentBench",
      "url": "https://arxiv.org/abs/2507.05257",
      "scale_note": "2,071 题；检索、测试时学习、长程理解、选择性遗忘"
    }
  ],
  "dataset": {
    "sources": [
      "LongMemEval v2",
      "MemoryAgentBench",
      "自建知识更新序列"
    ],
    "composition": "同一事实的旧 / 新两版成对出现；会话顺序固定并可重放",
    "manifest_ref": "dataset/manifest.json",
    "refresh": {
      "unseen_acceptance_every_rounds": 6,
      "replace_ratio": 0.25,
      "rule": "样本一经暴露即降级为 regression；unseen_acceptance 不得参与调参"
    }
  },
  "graders": [
    "longmemeval_accuracy",
    "refusal_score",
    "staleness_probe"
  ],
  "metrics": [
    {
      "id": "memory_accuracy",
      "label": "准确率",
      "direction": "higher",
      "primary": true,
      "unit": "ratio",
      "aggregation": "mean_over_cases",
      "grader": "longmemeval_accuracy",
      "threshold_status": "pending_baseline"
    },
    {
      "id": "stale_misuse_rate",
      "label": "过期知识误用率",
      "direction": "lower",
      "primary": false,
      "unit": "ratio",
      "aggregation": "mean_over_cases",
      "grader": "staleness_probe",
      "threshold_status": "pending_baseline"
    },
    {
      "id": "refusal_correctness",
      "label": "拒答正确率",
      "direction": "higher",
      "primary": false,
      "unit": "ratio",
      "aggregation": "mean_over_cases",
      "grader": "refusal_score",
      "threshold_status": "pending_baseline"
    }
  ],
  "gate": {
    "tier": "warn",
    "in_ci": true,
    "blocking_metrics": [
      "memory_accuracy"
    ],
    "ref": "../../monitor/thresholds.json"
  },
