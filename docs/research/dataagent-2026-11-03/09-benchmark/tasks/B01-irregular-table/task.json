{
  "id": "B01",
  "slug": "irregular-table",
  "title": "不规则表格理解",
  "plan_row": 1,
  "plan_ref": "../../../09-benchmark-plan.md",
  "catalog_atoms": [
    "DA01.4.2",
    "DA01.4.6",
    "DA02.1.1",
    "DA02.1.2",
    "DA02.2.1",
    "DA02.2.2",
    "DA02.2.3",
    "DA02.2.4",
    "DA02.4.1",
    "DA02.4.2",
    "DA02.4.3",
    "DA02.4.4",
    "DA02.4.5"
  ],
  "slice": "S0",
  "unit": "table",
  "why_not_unit_tested": "多行表头、合并单元格、合计行的识别依赖真实表格分布；单元测试只能覆盖合成表",
  "reference_benchmarks": [
    {
      "name": "RealHiTBench",
      "url": "https://arxiv.org/abs/2506.13405",
      "scale_note": "层级表 708 张 / 3,752 问答，24 领域"
    },
    {
      "name": "MiMoTable",
      "url": "https://aclanthology.org/2025.coling-main.173/",
      "scale_note": "428 个中英文表格 / 1,719 问答"
    }
  ],
  "dataset": {
    "sources": [
      "RealHiTBench",
      "MiMoTable",
      "脱敏客户报表（多行表头 / 合并单元格 / 合计行）"
    ],
    "composition": "外部 50% + 自建 50%；自建集按表头行数 / 合并单元格密度 / 合计行位置分层",
    "manifest_ref": "dataset/manifest.json",
    "refresh": {
      "unseen_acceptance_every_rounds": 6,
      "replace_ratio": 0.25,
      "rule": "样本一经暴露即降级为 regression；unseen_acceptance 不得参与调参"
    }
  },
  "graders": [
    "header_cell_match",
    "qa_exact_match",
    "row_retention"
  ],
  "metrics": [
    {
      "id": "header_cell_accuracy",
      "label": "表头单元格正确率",
      "direction": "higher",
      "primary": true,
      "unit": "ratio",
      "aggregation": "mean_over_cases",
      "grader": "header_cell_match",
      "threshold_status": "pending_baseline"
    },
    {
      "id": "row_retention",
      "label": "行保留率（静默丢行为 0）",
      "direction": "higher",
      "primary": false,
      "unit": "ratio",
      "aggregation": "mean_over_cases",
      "grader": "row_retention",
      "threshold_status": "pending_baseline"
    },
    {
      "id": "downstream_qa_accuracy",
      "label": "下游问答准确率",
      "direction": "higher",
      "primary": false,
      "unit": "ratio",
      "aggregation": "mean_over_cases",
      "grader": "qa_exact_match",
      "threshold_status": "pending_baseline"
    }
  ],
  "gate": {
    "tier": "block",
    "in_ci": true,
    "blocking_metrics": [
      "header_cell_accuracy"
    ],
    "ref": "../../monitor/thresholds.json"
  },
  "status": "collecting",
  "owner": "TBD",
  "notes_ref": "NOTES.md",
  "created": "2026-11-04"
}
