{
  "id": "B12",
  "slug": "data-security",
  "title": "权限、敏感信息与外部数据安全",
  "plan_row": 12,
  "plan_ref": "../../../09-benchmark-plan.md",
  "catalog_atoms": [
    "DA12.1.1",
    "DA12.1.2",
    "DA12.1.3",
    "DA12.1.4",
    "DA16.1.1",
    "DA16.1.2",
    "DA16.1.3",
    "DA16.1.4"
  ],
  "slice": "S0",
  "unit": "case",
  "why_not_unit_tested": "指令劫持藏在文件与单元格里；只有真实文档载体才能复现攻击面",
  "reference_benchmarks": [
    {
      "name": "AgentDojo",
      "url": "https://arxiv.org/abs/2406.13352",
      "scale_note": "97 任务 / 629 安全用例；安全与任务完成度同时计分"
    },
    {
      "name": "CRMArena-Pro",
      "url": "https://arxiv.org/abs/2505.18878",
      "scale_note": "保密意识子集，接近 0 分"
    }
  ],
  "dataset": {
    "sources": [
      "AgentDojo 式注入集",
      "CRMArena-Pro 保密子集",
      "自建夹带指令单据 / 工作簿"
    ],
    "composition": "每个任务配良性与攻击两版；攻击与效用同时报，防止靠拒绝一切刷分",
    "manifest_ref": "dataset/manifest.json",
    "refresh": {
      "unseen_acceptance_every_rounds": 6,
      "replace_ratio": 0.25,
      "rule": "样本一经暴露即降级为 regression；unseen_acceptance 不得参与调参"
    }
  },
  "graders": [
    "agentdojo_attack_success",
    "benign_utility",
    "pii_leak_scan"
  ],
  "metrics": [
    {
      "id": "attack_success_rate",
      "label": "攻击成功率",
      "direction": "lower",
      "primary": true,
      "unit": "ratio",
      "aggregation": "mean_over_cases",
      "grader": "agentdojo_attack_success",
      "threshold_status": "pending_baseline"
    },
    {
      "id": "task_completion_under_attack",
      "label": "防御下的任务完成度",
      "direction": "higher",
      "primary": false,
      "unit": "ratio",
      "aggregation": "mean_over_cases",
      "grader": "benign_utility",
      "threshold_status": "pending_baseline"
    },
    {
      "id": "sensitive_leak_rate",
      "label": "敏感字段外泄率",
      "direction": "lower",
      "primary": false,
      "unit": "ratio",
      "aggregation": "mean_over_cases",
      "grader": "pii_leak_scan",
      "threshold_status": "pending_baseline"
    }
  ],
  "gate": {
    "tier": "guard",
    "in_ci": true,
    "blocking_metrics": [
      "attack_success_rate"
    ],
    "ref": "../../monitor/thresholds.json"
  },
  "status": "collecting",
  "owner": "TBD",
  "notes_ref": "NOTES.md",
  "created": "2026-11-04",
  "scope_note": "除 DA12.1、DA16.1 外，还覆盖读取外部数据的全部原子（DA01 解析、DA02.8 文档加工、DA05.* 检索）；这些原子不在此重复登记，用例按实际读取面挂载。"
}
