  "slice": "按需",
  "unit": "task",
  "why_not_unit_tested": "跨文件综合、读业务手册、中间结果正确性只在多步链上出现；单步单测无法替代",
  "reference_benchmarks": [
    {
      "name": "DABstep",
      "url": "https://arxiv.org/abs/2506.23719",
      "scale_note": "约 450 题，Adyen 支付业务含业务手册；难题最佳低于 15%"
    },
    {
      "name": "KramaBench",
      "url": "https://arxiv.org/abs/2506.06541",
      "scale_note": "104 任务 / 1,700 文件 / 6 领域；端到端最佳约 55%"
    }
  ],
  "dataset": {
    "sources": [
      "DABstep（含业务手册）",
      "KramaBench",
      "自建跨文件分析任务"
    ],
    "composition": "外部集保证难度上限；自建集按业务领域切片，难题子集单独报分",
    "manifest_ref": "dataset/manifest.json",
    "refresh": {
      "unseen_acceptance_every_rounds": 6,
      "replace_ratio": 0.25,
      "rule": "样本一经暴露即降级为 regression；unseen_acceptance 不得参与调参"
    }
  },
  "graders": [
    "cost_report",
    "exact_match",
    "pass_k",
    "step_audit"
  ],
  "metrics": [
    {
      "id": "exact_match_accuracy",
      "label": "精确匹配准确率",
      "direction": "higher",
      "primary": true,
      "unit": "ratio",
      "aggregation": "mean_over_cases",
      "grader": "exact_match",
      "threshold_status": "pending_baseline"
    },
    {
      "id": "hard_subset_accuracy",
      "label": "难题子集准确率",
      "direction": "higher",
      "primary": false,
      "unit": "ratio",
      "aggregation": "mean_over_cases",
      "grader": "exact_match",
      "threshold_status": "pending_baseline"
    },
    {
      "id": "pass_k_stability",
      "label": "pass^k（k=3）",
      "direction": "higher",
      "primary": false,
      "unit": "ratio",
      "aggregation": "mean_over_cases",
      "grader": "pass_k",
      "threshold_status": "pending_baseline"
    },
    {
      "id": "cost_per_task",
      "label": "每题成本",
      "direction": "lower",
      "primary": false,
      "unit": "usd",
      "aggregation": "mean_over_cases",
      "grader": "cost_report",
      "threshold_status": "pending_baseline"
    },
    {
      "id": "steps_per_task",
      "label": "每题步数",
      "direction": "lower",
      "primary": false,
      "unit": "count",
      "aggregation": "mean_over_cases",
      "grader": "step_audit",
      "threshold_status": "pending_baseline"
    }
  ],
  "gate": {
    "tier": "warn",
    "in_ci": true,
    "blocking_metrics": [
      "exact_match_accuracy"
    ],
    "ref": "../../monitor/thresholds.json"
  },
